<section class="overflow-hidden rounded-2xl border border-white/10 bg-[#111114] shadow-xl">
  <div class="border-b border-white/10 px-6 py-6 sm:px-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 id="form-heading" class="mt-2 text-2xl font-bold text-white">Add new prompt</h2>
      </div>
    </div>
  </div>

  <form id="prompt-form" class="space-y-8 p-5 sm:p-8">
        <section class="space-y-5">
      <div class="section-heading">
        <span class="section-number">01</span>
        <div>
          <h3>Prompt details</h3>
        </div>
      </div>

      <div>
        <label for="prompt-title" class="field-label">Prompt name <span>*</span></label>
        <input
          id="prompt-title"
          required
          maxlength="160"
          class="form-control"
          placeholder="e.g. Cinematic Cyberpunk Portrait"
        />
      </div>

      <div>
        <div class="mb-2 flex items-center justify-between">
          <label for="prompt-content" class="field-label">Full prompt <span>*</span></label>
          <span class="text-xs text-gray-500">Required</span>
        </div>
        <textarea
          id="prompt-content"
          required
          rows="9"
          class="form-control resize-y leading-6"
          placeholder="Paste your complete AI prompt here..."
        ></textarea>
      </div>

      <div>
        <label for="prompt-description" class="field-label">Short description</label>
        <textarea
          id="prompt-description"
          rows="3"
          class="form-control resize-y"
          placeholder="Explain what this prompt creates or what it is useful for..."
        ></textarea>
      </div>
    </section>

    <div class="section-divider"></div>
    <section class="space-y-5">
      <div class="section-heading">
        <span class="section-number">02</span>
        <div>
          <h3>Format and publishing</h3>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="prompt-type" class="field-label">Prompt type <span>*</span></label>
          <select id="prompt-type" required class="form-control">
            <option value="image">Image</option>
            <option value="video">Video</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div>
          <label for="prompt-status" class="field-label">Publishing status <span>*</span></label>
          <select id="prompt-status" required class="form-control">
            <option value="draft">Save as draft</option>
            <option value="published">Publish immediately</option>
          </select>
        </div>
      </div>

      <div>
        <label for="prompt-thumbnail" class="field-label">
          Thumbnail image <span class="optional">(optional)</span>
        </label>

        <div class="upload-box">
          <div class="flex flex-wrap items-center gap-4">
            <div class="thumbnail-frame">
              <img
                id="thumbnail-preview"
                hidden
                alt="Thumbnail preview"
                class="h-full w-full object-cover"
              />
              <svg
                id="thumbnail-placeholder"
                viewBox="0 0 24 24"
                class="h-7 w-7 text-gray-500"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                <circle cx="85" cy="8.5" r="1.5"></circle>
                <path d="m21 15-5-5L5 21"></path>
              </svg>
            </div>

            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-gray-200">Thumbnail</p>
              <p class="mt-1 text-xs text-gray-500">
                JPEG, PNG, WebP or AVIF · 5 MB max
              </p>

              <label
                for="prompt-thumbnail"
                class="mt-3 inline-flex cursor-pointer rounded-lg border border-violet-500/30 bg-violet-500/10 px-3 py-2 text-xs font-medium text-violet-300 transition hover:bg-violet-500/20"
              >
                Choose image
              </label>

              <span id="thumbnail-filename" class="ml-2 text-xs text-gray-500">
                No image selected
              </span>
            </div>
          </div>

          <input
            id="prompt-thumbnail"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/avif"
            class="hidden"
          />
        </div>
      </div>
    </section>

    <div class="section-divider"></div>


    <section class="space-y-5">
      <div class="section-heading">
        <span class="section-number">03</span>
        <div>
          <h3>Categories and tags</h3>
        </div>
      </div>

      <div class="grid gap-5 lg:grid-cols-2">

        <div class="selection-panel">
          <div class="mb-3 flex items-center justify-between">
            <label class="field-label">Categories <span>*</span></label>
            <span id="category-count" class="selection-count">0 selected</span>
          </div>

          <div id="category-chips" class="selected-chips"></div>

          <input
            id="category-search"
            type="search"
            class="form-control mb-3"
            placeholder="Search categories..."
          />

          <div id="category-options" class="choice-list"></div>

          <div class="mt-4 flex gap-2">
            <input
              id="new-category"
              class="form-control min-w-0 flex-1"
              placeholder="New category name"
              maxlength="60"
            />
            <button type="button" id="add-category" class="secondary-button">
              Add
            </button>
          </div>
        </div>


        <div class="selection-panel">
          <div class="mb-3 flex items-center justify-between">
            <label class="field-label">Tags <span>*</span></label>
            <span id="tag-count" class="selection-count">0 selected</span>
          </div>

          <div id="tag-chips" class="selected-chips"></div>

          <input
            id="tag-search"
            type="search"
            class="form-control mb-3"
            placeholder="Search tags..."
          />

          <div id="tag-options" class="choice-list"></div>

          <div class="mt-4 flex gap-2">
            <input
              id="new-tag"
              class="form-control min-w-0 flex-1"
              placeholder="New tag name"
              maxlength="60"
            />
            <button type="button" id="add-tag" class="secondary-button">
              Add
            </button>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>


    <section class="space-y-5">
      <div class="section-heading">
        <span class="section-number">04</span>
        <div>
          <h3>Additional information</h3>

        </div>
      </div>

      <div>
        <label class="field-label">AI tools</label>
        <p class="mb-3 text-xs text-gray-500">

        </p>

        <div id="tool-options" class="grid grid-cols-2 gap-2 sm:grid-cols-3">
          {[
            "Midjourney",
            "DALL·E",
            "ChatGPT",
            "Stable Diffusion",
            "Flux",
            "Leonardo AI",
            "Ideogram",
            "Runway",
            "Kling AI",
            "Veo",
            "Sora",
            "Other",
          ].map((tool) => (
            <label class="check-card">
              <input type="checkbox" name="ai-tool" value={tool} />
              <span>{tool}</span>
            </label>
          ))}
        </div>
      </div>

      <div>
        <div class="mb-2 flex items-center justify-between">
          <label class="field-label">Related shortcuts</label>
          <span id="shortcut-count" class="selection-count">0 selected</span>
        </div>

        <div id="shortcut-chips" class="selected-chips"></div>

        <input
          id="shortcut-search"
          type="search"
          class="form-control mb-3"
          placeholder="Search shortcuts..."
        />

        <div id="shortcut-options" class="choice-list"></div>
      </div>
    </section>

    <div class="section-divider"></div>


    <section
      id="duplicate-warning"
      hidden
      class="rounded-xl border border-amber-500/30 bg-amber-500/5 p-4"
    >
      <p class="text-sm font-semibold text-amber-300">
        Possible duplicate detected
      </p>

      <div id="duplicate-details" class="mt-3 space-y-2 text-sm text-amber-200/80"></div>

      <label class="mt-4 flex cursor-pointer items-start gap-3 text-sm text-gray-300">
        <input
          id="duplicate-confirm"
          type="checkbox"
          class="mt-1 accent-violet-500"
        />
        <span>
          I have reviewed these matches and confirm that I want to save this prompt.
        </span>
      </label>
    </section>


    <div class="flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p
        id="prompt-form-message"
        role="status"
        aria-live="polite"
        class="text-sm text-gray-400"
      >
        Loading categories and tags...
      </p>

      <div class="flex flex-wrap gap-2">
        <button id="cancel-edit" type="button" class="secondary-button" hidden>Cancel edit</button>
        <button id="save-draft" type="submit" data-submit-status="draft" class="secondary-button">Save draft</button>
        <button id="save-prompt" type="submit" data-submit-status="published" class="primary-button">Publish prompt</button>
      </div>
    </div>
  </form>
</section>

<style>
  section.overflow-hidden.rounded-2xl {
    position: relative;
    isolation: isolate;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 22px;
    background:
      radial-gradient(ellipse at 4% 0%, rgb(34 211 238 / 9%), transparent 32%),
      radial-gradient(ellipse at 96% 12%, rgb(251 146 60 / 8%), transparent 30%),
      linear-gradient(145deg, #15171c, #0d0e13 72%);
    box-shadow: 0 28px 90px rgb(0 0 0 / 38%);
  }

  #form-heading {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -.045em;
  }

  section.overflow-hidden > div:first-child {
    border-color: rgb(255 255 255 / 9%);
    background: linear-gradient(100deg, rgb(34 211 238 / 7%), rgb(255 255 255 / 1%), rgb(251 146 60 / 6%));
  }

  #prompt-form { gap: 2rem; }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-heading h3 {
    color: #f4f4f5;
    font-family: "Space Grotesk", sans-serif;
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -.02em;
  }

  .section-number {
    display: grid;
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    place-items: center;
    border: 1px solid rgb(34 211 238 / 28%);
    border-radius: 11px;
    background: linear-gradient(145deg, rgb(34 211 238 / 18%), rgb(34 211 238 / 5%));
    color: #67e8f9;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 700;
  }

  #prompt-form > section:nth-of-type(2) .section-number {
    border-color: rgb(251 146 60 / 32%);
    background: rgb(251 146 60 / 10%);
    color: #fdba74;
  }

  #prompt-form > section:nth-of-type(3) .section-number {
    border-color: rgb(167 139 250 / 32%);
    background: rgb(167 139 250 / 10%);
    color: #c4b5fd;
  }

  #prompt-form > section:nth-of-type(4) .section-number {
    border-color: rgb(52 211 153 / 32%);
    background: rgb(52 211 153 / 10%);
    color: #6ee7b7;
  }

  .section-heading:after {
    content: "";
    height: 1px;
    flex: 1;
    margin-left: 8px;
    background: linear-gradient(90deg, rgb(34 211 238 / 25%), transparent);
  }

  .section-divider { height: 1px; background: rgb(255 255 255 / 8%); }

  .field-label {
    display: block;
    margin-bottom: 9px;
    color: #e4e4e7;
    font-size: 12px;
    font-weight: 600;
  }

  .field-label > span:not(.optional) { color: #fb923c; }
  .optional { color: #71717a; font-weight: 400; }

  .form-control {
    width: 100%;
    min-width: 0;
    border: 1px solid rgb(255 255 255 / 11%);
    border-radius: 11px;
    background: #090b10;
    padding: 12px 14px;
    color: #f4f4f5;
    font-size: 13px;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .form-control:focus {
    border-color: rgb(34 211 238 / 65%);
    background: #0b1015;
    box-shadow: 0 0 0 3px rgb(34 211 238 / 10%);
  }

  .form-control::placeholder { color: #666b78; }
  textarea.form-control { min-height: 90px; }
  #prompt-content { min-height: 220px; line-height: 1.7; }

  .upload-box {
    border: 1px dashed rgb(34 211 238 / 25%);
    border-radius: 14px;
    background: linear-gradient(120deg, rgb(34 211 238 / 5%), rgb(255 255 255 / 2%), rgb(251 146 60 / 4%));
    padding: 18px;
    transition: border-color 160ms ease, background 160ms ease;
  }

  .upload-box:hover { border-color: rgb(34 211 238 / 60%); }
  .thumbnail-frame {
    display: flex;
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 11px;
    background: #11151b;
  }

  .selection-panel {
    min-width: 0;
    border: 1px solid rgb(255 255 255 / 9%);
    border-radius: 15px;
    background: linear-gradient(145deg, rgb(255 255 255 / 3%), rgb(0 0 0 / 17%));
    padding: 16px;
  }

  .selection-panel:nth-child(1) { box-shadow: inset 0 1px 0 rgb(167 139 250 / 14%); }
  .selection-panel:nth-child(2) { box-shadow: inset 0 1px 0 rgb(34 211 238 / 14%); }
  .selection-count {
    color: #9298a5;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
  }

  .selected-chips { display: flex; min-height: 0; flex-wrap: wrap; gap: 7px; margin-bottom: 10px; }
  .selected-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid rgb(34 211 238 / 27%);
    border-radius: 999px;
    background: rgb(34 211 238 / 9%);
    padding: 5px 9px;
    color: #a5f3fc;
    font-size: 11px;
  }

  .selected-chip button { color: #67e8f9; font-size: 15px; line-height: 1; }
  .choice-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
    max-height: 210px;
    overflow-y: auto;
    padding: 2px;
  }

  .choice-item, .check-card {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 9px;
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 9px;
    background: rgb(255 255 255 / 3%);
    padding: 10px;
    color: #d4d4d8;
    cursor: pointer;
