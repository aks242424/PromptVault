  .pv-utility-item:hover { transform:translateY(-1px); border-color:rgba(103,232,249,.32); background:rgba(34,211,238,.07); }
  .pv-utility-item-details { display:flex; flex:1 1 auto; flex-direction:column; align-items:flex-start; gap:5px; min-width:0; }
  .pv-utility-item-details strong { display:block; width:100%; margin:0 !important; color:#f4f5f8; font-size:13px; font-weight:650; line-height:1.45; overflow-wrap:anywhere; }
  .pv-utility-item-details small { display:block; margin:0 !important; color:#8d9aaa; font:700 9px/1.4 ui-monospace,SFMono-Regular,monospace; letter-spacing:.13em; }
