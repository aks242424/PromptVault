  .pv-utility-empty { margin:0 !important; padding:14px; border:1px dashed rgba(255,255,255,.13); border-radius:13px; color:#9ca7b7; font-size:12px; line-height:1.7; }
  .pv-random-result { display:flex; flex-direction:column; align-items:stretch; gap:11px; width:100%; min-width:0; }
  .pv-random-eyebrow { margin:0; color:#67e8f9; font:700 9px/1.4 ui-monospace,SFMono-Regular,monospace; letter-spacing:.17em; }
  .pv-random-result h3 { margin:0 !important; color:#f7f8fb; font:700 clamp(18px,4vw,22px)/1.25 system-ui,sans-serif; letter-spacing:-.035em; overflow-wrap:anywhere; }
  .pv-random-type { margin:0 !important; color:#a3aab8; font-size:11px; }
  .pv-random-actions { display:flex; flex-wrap:wrap; align-items:center; gap:9px; margin-top:5px; }
  .pv-utility-action,.pv-utility-secondary { display:inline-flex !important; align-items:center; justify-content:center; width:auto !important; min-height:38px; margin:0 !important; padding:0 14px !important; border:1px solid rgba(251,146,60,.32); border-radius:11px; background:rgba(249,115,22,.11); color:#fed7aa !important; font-size:11px; font-weight:700; line-height:1; text-decoration:none !important; cursor:pointer; white-space:nowrap; }
  .pv-utility-secondary { border-color:rgba(255,255,255,.13); background:rgba(255,255,255,.05); color:#d7dce5 !important; }
  .pv-utility-action:hover,.pv-utility-secondary:hover { filter:brightness(1.15); }
  .pv-utility-settings { display:flex; flex-direction:column; gap:15px; width:100%; }
  .pv-utility-setting { display:grid; grid-template-columns:minmax(0,1fr) 18px; align-items:start; gap:13px; width:100%; margin:0 !important; padding:0 0 14px !important; border-bottom:1px solid rgba(255,255,255,.08); cursor:pointer; }
  .pv-utility-setting-copy { display:flex; flex-direction:column; align-items:flex-start; gap:5px; min-width:0; }
  .pv-utility-setting strong { color:#eef0f5; font-size:12px; line-height:1.4; }
  .pv-utility-setting small { color:#98a2b2; font-size:11px; line-height:1.55; }
  .pv-utility-setting input { width:16px !important; height:16px !important; margin:2px 0 0 !important; accent-color:#a78bfa; }
  .pv-utility-note { margin:0 !important; color:#8e99aa; font-size:10px; line-height:1.6; }
  .pv-utility-mobile { position:fixed; left:50%; bottom:14px; z-index:1000; display:block; transform:translateX(-50%); }
  .pv-utility-mobile-nav { flex-direction:row; gap:7px; padding:8px; border-radius:19px; }
  .pv-utility-mobile-nav .pv-utility-button { width:43px !important; height:43px !important; flex-basis:43px; }
  .pv-utility-mobile-panel { position:fixed; right:14px; bottom:80px; left:14px; z-index:1001; width:auto; max-width:480px; max-height:min(65dvh,520px); margin:0 auto; }
  .pv-utility-mobile-panel .pv-utility-content { max-height:calc(65dvh - 145px); }
  @supports not (height:100dvh) {
    .pv-utility-panel { max-height:calc(100vh - 40px); }
    .pv-utility-mobile-panel { max-height:min(65vh,520px); }
    .pv-utility-mobile-panel .pv-utility-content { max-height:calc(65vh - 145px); }
  }
  @media (min-width:768px) { .pv-utility-dock { display:block; } .pv-utility-mobile { display:none; } }
  @media (max-width:767px) { .pv-utility-dock { display:none; } .pv-utility-panel:not(.pv-utility-mobile-panel) { display:none !important; } }
  @media (prefers-reduced-motion:reduce) { .pv-utility-button,.pv-utility-item,.pv-utility-close { transition:none !important; } }
  html.pv-reduced-motion *,html.pv-reduced-motion *::before,html.pv-reduced-motion *::after { scroll-behavior:auto !important; animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; }
</style>

<script>
  import { supabase } from "../lib/supabase.js";

  type ItemType = "prompt" | "shortcut";
  type UtilityName = "favorites" | "recent" | "random" | "settings";
  type SavedItem = { type: ItemType; id: string; title: string; url: string };
  type UtilitySettings = { reducedMotion: boolean; reopenLastPanel: boolean };
  type PromptRow = { id: string; title: string | null };
  type ShortcutRow = { id: string; name: string | null };

  const FAVORITES_KEY = "promptvault:favourites";
  const RECENT_KEY = "promptvault:recent";
  const SETTINGS_KEY = "promptvault:settings";
  const LAST_PANEL_KEY = "promptvault:last-utility";

  const utilityTitles: Record<UtilityName, string> = {
    favorites: "Favourites",
    recent: "Recently viewed",
    random: "Random discovery",
    settings: "Settings"
  };

  const desktopPanel = document.querySelector<HTMLElement>("#utility-panel");
  const desktopTitle = document.querySelector<HTMLElement>("#utility-title");
  const desktopContent = document.querySelector<HTMLElement>("#utility-content");
  const mobilePanel = document.querySelector<HTMLElement>("#mobile-utility-panel");
  const mobileTitle = document.querySelector<HTMLElement>("#mobile-utility-title");
  const mobileContent = document.querySelector<HTMLElement>("#mobile-utility-content");

  function isUtilityName(value: string | null): value is UtilityName {
    return value === "favorites" || value === "recent" || value === "random" || value === "settings";
  }

  type StorageArea = "local" | "session";

  function getStorage(area: StorageArea): Storage | null {
    try {
      return area === "local" ? window.localStorage : window.sessionStorage;
    } catch {
      return null;
    }
  }

  function safeStorageGet(area: StorageArea, key: string): string | null {
    try { return getStorage(area)?.getItem(key) ?? null; } catch { return null; }
  }

  function safeStorageSet(area: StorageArea, key: string, value: string): void {
    try { getStorage(area)?.setItem(key, value); } catch (error) {
      console.warn("PromptVault utility preference could not be saved.", error);
    }
  }

  function safeStorageRemove(area: StorageArea, key: string): void {
    try { getStorage(area)?.removeItem(key); } catch { /* Storage may be unavailable. */ }
  }

  function readList(key: string): SavedItem[] {
    try {
      const parsed: unknown = JSON.parse(safeStorageGet("local", key) ?? "[]");
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((value: unknown): value is SavedItem => {
        if (!value || typeof value !== "object") return false;
        const item = value as Record<string, unknown>;
        if (!((item.type === "prompt" || item.type === "shortcut") &&
          typeof item.id === "string" && typeof item.title === "string" && typeof item.url === "string")) return false;
        try {
          const destination = new URL(item.url, window.location.origin);
          return destination.origin === window.location.origin && destination.protocol === window.location.protocol;
        } catch {
          return false;
        }
      });
    } catch { return []; }
  }

  function readSettings(): UtilitySettings {
    try {
      const parsed: unknown = JSON.parse(safeStorageGet("local", SETTINGS_KEY) ?? "{}");
      const value = parsed && typeof parsed === "object" ? parsed as Record<string, unknown> : {};
      return { reducedMotion: value.reducedMotion === true, reopenLastPanel: value.reopenLastPanel === true };
    } catch { return { reducedMotion: false, reopenLastPanel: false }; }
  }

  let settings = readSettings();

  function saveSettings(): void {
    safeStorageSet("local", SETTINGS_KEY, JSON.stringify(settings));
    document.documentElement.classList.toggle("pv-reduced-motion", settings.reducedMotion);
  }

  function element<K extends keyof HTMLElementTagNameMap>(
    tag: K, className = "", text = ""
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  function closePanels(): void {
    if (desktopPanel) desktopPanel.hidden = true;
    if (mobilePanel) mobilePanel.hidden = true;
    document.querySelectorAll<HTMLButtonElement>("[data-utility]").forEach((button) => {
      button.setAttribute("aria-expanded", "false");
    });
  }

  function showContent(name: UtilityName, content: HTMLElement): HTMLElement | null {
    closePanels();
    document.querySelectorAll<HTMLButtonElement>(`[data-utility="${name}"]`).forEach((button) => {
      button.setAttribute("aria-expanded", "true");
    });
    if (settings.reopenLastPanel) safeStorageSet("session", LAST_PANEL_KEY, name);

    if (window.matchMedia("(max-width: 767px)").matches) {
      if (mobileTitle) mobileTitle.textContent = utilityTitles[name];
      mobileContent?.replaceChildren(content);
      if (mobilePanel) mobilePanel.hidden = false;
      return mobileContent ?? null;
    }

    if (desktopTitle) desktopTitle.textContent = utilityTitles[name];
    desktopContent?.replaceChildren(content);
    if (desktopPanel) desktopPanel.hidden = false;
    return desktopContent ?? null;
  }

  function renderSavedItems(items: SavedItem[], emptyMessage: string): HTMLElement {
    const list = element("div", "pv-utility-list");
    if (items.length === 0) {
      list.append(element("p", "pv-utility-empty", emptyMessage));
      return list;
    }

    for (const item of items) {
      const link = element("a", "pv-utility-item");
      link.href = item.url;
      const details = element("span", "pv-utility-item-details");
      details.append(element("strong", "", item.title));
      details.append(element("small", "", item.type === "prompt" ? "PROMPT" : "SHORTCUT"));
      link.append(details, element("span", "pv-utility-item-arrow", "↗"));
      list.append(link);
    }
    return list;
  }

  function renderSettings(): HTMLElement {
    const wrapper = element("div", "pv-utility-settings");

    const addSetting = (title: string, description: string, checked: boolean, onChange: (value: boolean) => void): void => {
      const label = element("label", "pv-utility-setting");
      const copy = element("span", "pv-utility-setting-copy");
      copy.append(element("strong", "", title), element("small", "", description));
      const input = element("input");
      input.type = "checkbox";
      input.checked = checked;
      input.addEventListener("change", () => onChange(input.checked));
      label.append(copy, input);
      wrapper.append(label);
    };

    addSetting("Reduced motion", "Reduce interface movement and transitions.", settings.reducedMotion, (value) => {
      settings.reducedMotion = value;
      saveSettings();
    });
    addSetting("Reopen last utility", "Restore the last utility panel when you return.", settings.reopenLastPanel, (value) => {
      settings.reopenLastPanel = value;
      saveSettings();
      if (!value) safeStorageRemove("session", LAST_PANEL_KEY);
    });
    wrapper.append(element("p", "pv-utility-note", "Your preferences are saved in this browser."));
    return wrapper;
  }

  async function loadRandomItem(target: HTMLElement): Promise<void> {
    const loading = element("p", "pv-utility-empty", "Finding something to explore…");
    target.replaceChildren(loading);

    try {
      const [promptResult, shortcutResult] = await Promise.all([
        supabase.from("prompts").select("id,title").eq("status", "published").limit(500),
        supabase.from("shortcuts").select("id,name").eq("status", "published").limit(500)
      ]);

      if (promptResult.error) throw promptResult.error;
      if (shortcutResult.error) throw shortcutResult.error;

      const prompts = (promptResult.data ?? []) as PromptRow[];
      const shortcuts = (shortcutResult.data ?? []) as ShortcutRow[];
      const candidates: SavedItem[] = [
        ...prompts.filter((row) => typeof row.id === "string" && typeof row.title === "string" && row.title.trim()).map((row) => ({
          type: "prompt" as const, id: row.id, title: row.title as string,
          url: `/prompts#prompt-${encodeURIComponent(row.id)}`
        })),
        ...shortcuts.filter((row) => typeof row.id === "string" && typeof row.name === "string" && row.name.trim()).map((row) => ({
          type: "shortcut" as const, id: row.id, title: row.name as string,
          url: `/shortcuts#shortcut-${encodeURIComponent(row.id)}`
        }))
      ];

      const result = element("div", "pv-random-result");
      if (candidates.length === 0) {
        result.append(element("p", "pv-utility-empty", "There are no published prompts or shortcuts to discover yet."));
      } else {
        const chosen = candidates[Math.floor(Math.random() * candidates.length)];
        result.append(element("p", "pv-random-eyebrow", "YOUR RANDOM PICK"));
        result.append(element("h3", "", chosen.title));
        result.append(element("p", "pv-random-type", chosen.type === "prompt" ? "PROMPT" : "SHORTCUT"));
        const actions = element("div", "pv-random-actions");
        const openLink = element("a", "pv-utility-action", "Open item ↗");
        openLink.href = chosen.url;
        const another = element("button", "pv-utility-secondary", "Try another");
        another.type = "button";
        another.addEventListener("click", () => { void loadRandomItem(target); });
        actions.append(openLink, another);
        result.append(actions);
      }

      if (target.isConnected) target.replaceChildren(result);
    } catch (error) {
      console.error("PromptVault random discovery error:", error);
      if (target.isConnected) target.replaceChildren(element("p", "pv-utility-empty", "Could not load a random item. Please try again."));
    }
  }

  function openUtility(name: UtilityName): void {
    let content: HTMLElement;
    if (name === "favorites") {
      content = renderSavedItems(readList(FAVORITES_KEY), "No favourites saved yet. Use the star on a prompt or shortcut to save it.");
    } else if (name === "recent") {
      content = renderSavedItems(readList(RECENT_KEY), "Nothing viewed recently. Open a prompt or shortcut and it will appear here.");
    } else if (name === "settings") {
      content = renderSettings();
    } else {
      content = element("div", "pv-utility-list");
    }

    const target = showContent(name, content);
    if (name === "random" && target) void loadRandomItem(target);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-utility]").forEach((button) => {
    button.addEventListener("click", () => {
      const name = button.dataset.utility ?? null;
      if (isUtilityName(name)) openUtility(name);
    });
  });

  document.querySelector("#utility-close")?.addEventListener("click", closePanels);
  document.querySelector("#mobile-utility-close")?.addEventListener("click", closePanels);
  document.addEventListener("keydown", (event: KeyboardEvent) => {
    if (event.key === "Escape") closePanels();
  });

  window.addEventListener("promptvault:favourites-updated", () => {
    if (desktopPanel && !desktopPanel.hidden && desktopTitle?.textContent === utilityTitles.favorites) openUtility("favorites");
    if (mobilePanel && !mobilePanel.hidden && mobileTitle?.textContent === utilityTitles.favorites) openUtility("favorites");
  });

  window.addEventListener("promptvault:recent-updated", () => {
    if (desktopPanel && !desktopPanel.hidden && desktopTitle?.textContent === utilityTitles.recent) openUtility("recent");
    if (mobilePanel && !mobilePanel.hidden && mobileTitle?.textContent === utilityTitles.recent) openUtility("recent");
  });

  saveSettings();
  if (settings.reopenLastPanel) {
    const lastPanel = safeStorageGet("session", LAST_PANEL_KEY);
    if (isUtilityName(lastPanel)) openUtility(lastPanel);
  }
</script>
