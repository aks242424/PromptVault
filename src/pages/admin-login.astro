---
export const prerender = true;

import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Admin Login | PromptVault">
  <main class="login-shell">
    <section class="login-card">
      <div class="brand-mark">P</div>
      <span class="eyebrow">PROMPTVAULT / SECURE ACCESS</span>
      <h1>Admin login</h1>
      <p class="intro">Sign in with your administrator account.</p>

      <form id="admin-login" class="login-form">
        <label>
          Email
          <input id="email" type="email" required autocomplete="username" placeholder="Admin email" />
        </label>
        <label>
          Password
          <input id="password" type="password" required autocomplete="current-password" placeholder="Password" />
        </label>
        <button id="login-button" type="submit">Sign in</button>
        <p id="login-message" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>
</MainLayout>

<style>
  .login-shell {
    min-height: calc(100vh - 80px);
    display: grid;
    place-items: center;
    padding: 48px 20px 90px;
    color: #f4f4f5;
    background:
      radial-gradient(ellipse at 8% 5%, #0e749044, transparent 34%),
      radial-gradient(ellipse at 92% 18%, #c2410c30, transparent 32%),
      #080b10;
  }

  .login-card {
    width: min(100%, 440px);
    padding: 36px;
    border: 1px solid #ffffff20;
    border-radius: 22px;
    background: linear-gradient(145deg, #151c25f2, #0e131bf5);
    box-shadow: 0 24px 90px #0008, inset 0 1px #ffffff08;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 24px;
    border: 1px solid #67e8f955;
    border-radius: 13px;
    background: linear-gradient(135deg, #0e7490, #155e75);
    color: #cffafe;
    font-size: 19px;
    font-weight: 850;
  }

  .eyebrow {
    color: #67e8f9;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .2em;
  }

  h1 {
    margin-top: 12px;
    font-size: 32px;
    font-weight: 760;
    letter-spacing: -.045em;
  }

  .intro {
    margin-top: 8px;
    color: #94a3b8;
    font-size: 13px;
  }

  .login-form {
    display: grid;
    gap: 17px;
    margin-top: 27px;
  }

  .login-form label {
    display: grid;
    gap: 8px;
    color: #cbd5e1;
    font-size: 12px;
    font-weight: 650;
  }

  .login-form input {
    width: 100%;
    min-width: 0;
    border: 1px solid #ffffff1b;
    border-radius: 11px;
    background: #090e15;
    color: #f4f4f5;
    padding: 12px 14px;
    outline: none;
  }

  .login-form input:focus {
    border-color: #22d3ee99;
    box-shadow: 0 0 0 3px #06b6d41c;
  }

  .login-form button {
    border: 0;
    border-radius: 10px;
    padding: 13px;
    color: #04212a;
    background: linear-gradient(110deg, #67e8f9, #22d3ee 55%, #0ea5e9);
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
  }

  .login-form button:disabled {
    cursor: not-allowed;
    opacity: .55;
  }

  #login-message {
    min-height: 18px;
    color: #fda4af;
    font-size: 12px;
  }

  @media (max-width: 480px) {
    .login-card {
      padding: 27px 22px;
    }
  }
</style>

<script>
  import { supabase } from "../lib/supabase.js";

  const form = document.querySelector<HTMLFormElement>("#admin-login");
  const emailInput = document.querySelector<HTMLInputElement>("#email");
  const passwordInput = document.querySelector<HTMLInputElement>("#password");
  const loginButton = document.querySelector<HTMLButtonElement>("#login-button");
  const message = document.querySelector<HTMLElement>("#login-message");

  if (!form || !emailInput || !passwordInput || !loginButton || !message) {
    throw new Error("Admin login form elements are missing.");
  }

  const params = new URLSearchParams(window.location.search);
  if (params.get("error") === "not-admin") {
    message.textContent = "This account does not have administrator access.";
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    loginButton.disabled = true;
    loginButton.textContent = "Signing in...";
    message.textContent = "";

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email: emailInput.value.trim(),
        password: passwordInput.value,
      });

      if (error) throw error;

      const { data: adminRecord, error: adminError } = await supabase
        .from("admin_users")
        .select("user_id")
        .eq("user_id", data.user.id)
        .maybeSingle();

      if (adminError || !adminRecord) {
        await supabase.auth.signOut();
        throw new Error("This account does not have administrator access.");
      }

      window.location.replace("/admin");
    } catch (error) {
      message.textContent =
        error instanceof Error ? error.message : "Sign-in failed.";
      loginButton.disabled = false;
      loginButton.textContent = "Sign in";
    }
  });
</script>
