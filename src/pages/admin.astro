  const csvInput = $<HTMLInputElement>("#bulk-csv-file");
  const csvValidateButton = $<HTMLButtonElement>("#bulk-validate-button");
  const csvImportButton = $<HTMLButtonElement>("#bulk-import-button");
  const csvFileName = $<HTMLElement>("#bulk-file-name");
  const csvValidation = $<HTMLElement>("#bulk-validation");
  const csvErrors = $<HTMLElement>("#bulk-errors");
  const csvPreview = $<HTMLElement>("#bulk-preview");
  const csvPreviewList = $<HTMLElement>("#bulk-preview-list");
  const csvSelectionCount = $<HTMLElement>("#bulk-selection-count");
  let selectedCsvFile: File | null = null;
  let validatedRows: any[] = [];
  let validationReady = false;

  function parseCsv(text: string) {
    const rows: string[][] = [];
    let row: string[] = [], field = "", quoted = false;
    for (let i = 0; i < text.length; i++) {
      const char = text[i];
      if (quoted) {
        if (char === '"' && text[i + 1] === '"') { field += '"'; i++; }
        else if (char === '"') quoted = false;
        else field += char;
      } else if (char === '"' && field.length === 0) quoted = true;
      else if (char === ",") { row.push(field); field = ""; }
      else if (char === "\n" || char === "\r") {
        if (char === "\r" && text[i + 1] === "\n") i++;
        row.push(field); field = "";
        if (row.some((cell) => cell.trim())) rows.push(row);
        row = [];
      } else field += char;
    }
    if (quoted) throw new Error("CSV contains an unclosed quoted field.");
    if (field.length || row.length) { row.push(field); if (row.some((cell) => cell.trim())) rows.push(row); }
    return rows;
  }

  function splitList(value: string) {
    // CSV category/tag cells may use either pipe or semicolon separators.
    // Treat every token as a separate database category/tag, and deduplicate
    // case-insensitively within the same CSV cell.
    const seen = new Set<string>();
    return value
      .split(/[|;\n\r]+/)
      .map((part) => part.trim().replace(/^(["'])|(["'])$/g, "").trim())
      .filter((part) => {
        const key = part.toLocaleLowerCase();
        if (!part || seen.has(key)) return false;
        seen.add(key);
        return true;
      });
  }
  function normalizeContent(value: string) { return value.toLowerCase().trim().replace(/\s+/g, " "); }
  function normalizeTitle(value: string) { return value.toLowerCase().trim().replace(/\s+/g, " "); }
  function slugify(value: string) { return value.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "item"; }

  function showCsvErrors(messages: string[]) {
    csvErrors.replaceChildren();
    if (!messages.length) { csvErrors.hidden = true; return; }
    const list = document.createElement("ul");
    messages.forEach((message) => { const item = document.createElement("li"); item.textContent = message; list.append(item); });
    csvErrors.append(list); csvErrors.hidden = false;
  }

  function updateSelectionCount() {
    const selected = validatedRows.filter((item) => item.selected && item.state === "ready").length;
    csvSelectionCount.textContent = `${selected} selected of ${validatedRows.filter((item) => item.state === "ready").length} available`;
    csvImportButton.disabled = !validationReady || selected === 0;
  }

  function renderCsvPreview() {
    csvPreviewList.replaceChildren();
    validatedRows.forEach((item) => {
      const row = document.createElement("label");
      row.className = "bulk-preview-row";
      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.checked = item.selected === true;
      checkbox.disabled = item.state !== "ready";
      checkbox.addEventListener("change", () => { item.selected = checkbox.checked; updateSelectionCount(); });
      const details = document.createElement("div");
      const title = document.createElement("div");
      title.className = "bulk-preview-title";
      title.textContent = `Row ${item.line}: ${item.label || "(unnamed item)"}`;
      const meta = document.createElement("div");
      meta.className = "bulk-preview-meta";
      meta.textContent = `${item.item_type} · ${item.status}${item.item_type === "prompt" ? ` · ${item.prompt_type}` : ""}${item.reason ? ` · ${item.reason}` : ""}`;
      details.append(title, meta);
      const state = document.createElement("span");
      state.className = `bulk-row-state${item.state === "duplicate" ? " duplicate" : item.state === "invalid" ? " invalid" : ""}`;
      state.textContent = item.state === "ready" ? "READY" : item.state === "duplicate" ? "DUPLICATE" : item.state === "imported" ? "IMPORTED" : "INVALID";
      row.append(checkbox, details, state);
      csvPreviewList.append(row);
    });
    csvPreview.hidden = validatedRows.length === 0;
    updateSelectionCount();
  }

  $("#download-csv-template").addEventListener("click", () => {
    const sample = 'item_type,title,name,content,prompt_type,description,categories,tags,ai_tools,status\r\n' +
      'prompt,"Neon Portrait",,"A cinematic neon-lit portrait of a subject...",image,"Neon portrait prompt","Portrait|Cyberpunk","4K|Neon","Midjourney|ChatGPT",draft\r\n' +
      'shortcut,,"/windy",,,"Visible or implied wind","Weather|Nature","wind|atmosphere",,draft\r\n';
    const url = URL.createObjectURL(new Blob([sample], { type: "text/csv;charset=utf-8" }));
    const anchor = document.createElement("a"); anchor.href = url; anchor.download = "promptvault-import-template.csv"; anchor.click(); URL.revokeObjectURL(url);
  });

  $("#bulk-select-all").addEventListener("click", () => {
    validatedRows.forEach((item) => { if (item.state === "ready") item.selected = true; });
    renderCsvPreview();
  });
  $("#bulk-clear-selection").addEventListener("click", () => {
    validatedRows.forEach((item) => { if (item.state === "ready") item.selected = false; });
    renderCsvPreview();
  });

  csvInput.addEventListener("change", () => {
    selectedCsvFile = csvInput.files?.[0] || null;
    validatedRows = []; validationReady = false;
    csvFileName.textContent = selectedCsvFile ? selectedCsvFile.name : "No file selected.";
    csvValidateButton.disabled = !selectedCsvFile;
    csvImportButton.disabled = true;
    csvValidation.textContent = "";
    csvValidation.className = "bulk-validation";
    csvPreview.hidden = true;
    csvPreviewList.replaceChildren();
    showCsvErrors([]);
  });

  csvValidateButton.addEventListener("click", async () => {
    if (!selectedCsvFile) return;
    csvValidateButton.disabled = true;
    csvValidateButton.textContent = "Validating...";
    csvImportButton.disabled = true;
    validationReady = false;
    validatedRows = [];
    csvPreview.hidden = true;
    csvValidation.className = "bulk-validation";
    csvValidation.textContent = "Checking CSV structure, item fields, and duplicates...";
    showCsvErrors([]);

    try {
      const rawRows = parseCsv(await selectedCsvFile.text());
      if (rawRows.length < 2) throw new Error("The CSV must contain a header and at least one data row.");
      const headers = rawRows[0].map((header) => header.trim().toLowerCase().replace(/^\uFEFF/, ""));
      if (new Set(headers).size !== headers.length) throw new Error("CSV contains duplicate column names.");
      const allowedHeaders = ["item_type", "title", "name", "content", "prompt_type", "description", "categories", "tags", "ai_tools", "status"];
      const unknownHeaders = headers.filter((header) => !allowedHeaders.includes(header));
      if (unknownHeaders.length) throw new Error(`Unknown CSV columns: ${unknownHeaders.join(", ")}`);
      const index = Object.fromEntries(headers.map((header, i) => [header, i]));
      if (!headers.includes("item_type")) {
        throw new Error("Missing required column: item_type. Every row must explicitly be marked prompt or shortcut. Download the updated CSV template.");
      }
      const [promptResult, shortcutResult] = await Promise.all([
        supabase.from("prompts").select("id, title, content, normalized_content"),
        supabase.from("shortcuts").select("id, name, description")
      ]);
      if (promptResult.error) throw promptResult.error;
      if (shortcutResult.error) throw shortcutResult.error;

      const existingPromptTitles = new Set((promptResult.data || []).map((item: any) => normalizeTitle(item.title || "")));
      const existingPromptContents = new Set((promptResult.data || []).map((item: any) => normalizeContent(item.normalized_content || item.content || "")));
      const existingShortcutNames = new Set((shortcutResult.data || []).map((item: any) => normalizeTitle(item.name || "")));
      const seenPromptTitles = new Set<string>(), seenPromptContents = new Set<string>(), seenShortcutNames = new Set<string>();

      rawRows.slice(1).forEach((cells, rowIndex) => {
        const line = rowIndex + 2;
        const get = (key: string) => index[key] === undefined ? "" : (cells[index[key]] || "").trim();
        const itemType = get("item_type").toLowerCase();
        const title = get("title"), name = get("name"), content = get("content");
        const label = itemType === "shortcut" ? name : title;
        const promptType = get("prompt_type").toLowerCase();
        // Import is intentionally draft-only. CSV status values are ignored.
        const status = "draft";
        const categoryNames = splitList(get("categories")), tagNames = splitList(get("tags"));
        const aiTools = splitList(get("ai_tools"));
        const issues: string[] = [];
        if (cells.length !== headers.length) issues.push(`expected ${headers.length} columns, found ${cells.length}`);
        if (!["prompt", "shortcut"].includes(itemType)) issues.push("item_type must be prompt or shortcut");
        if (itemType === "prompt") {
          if (!title) issues.push("title is required for prompts");
          if (!content) issues.push("content is required for prompts");
          if (!content.trim()) issues.push("prompt content cannot be empty");
          if (!["image", "video", "other"].includes(promptType)) issues.push("prompt_type must be image, video, or other for prompts");
        } else if (itemType === "shortcut") {
          if (!name) issues.push("name is required for shortcuts");
          if (!get("description")) issues.push("description is required for shortcuts");
        }
        const normalizedLabel = normalizeTitle(label || "");
        const normalized = normalizeContent(content || "");
        const duplicateReasons: string[] = [];
        if (itemType === "prompt") {
          if (normalizedLabel && existingPromptTitles.has(normalizedLabel)) duplicateReasons.push("prompt title already exists");
          if (normalized && existingPromptContents.has(normalized)) duplicateReasons.push("prompt content already exists");
          if (normalizedLabel && seenPromptTitles.has(normalizedLabel)) duplicateReasons.push("prompt title duplicates an earlier CSV row");
          if (normalized && seenPromptContents.has(normalized)) duplicateReasons.push("prompt content duplicates an earlier CSV row");
          if (normalizedLabel) seenPromptTitles.add(normalizedLabel);
          if (normalized) seenPromptContents.add(normalized);
        } else if (itemType === "shortcut") {
          if (normalizedLabel && existingShortcutNames.has(normalizedLabel)) duplicateReasons.push("shortcut name already exists");
          if (normalizedLabel && seenShortcutNames.has(normalizedLabel)) duplicateReasons.push("shortcut name duplicates an earlier CSV row");
          if (normalizedLabel) seenShortcutNames.add(normalizedLabel);
        }
        validatedRows.push({
          line, item_type: itemType, title, name, label, content, prompt_type: promptType,
          description: get("description") || "", categories: categoryNames, tags: tagNames,
          ai_tools: aiTools, status,
          state: issues.length ? "invalid" : duplicateReasons.length ? "duplicate" : "ready",
          reason: [...issues, ...duplicateReasons].join("; "),
          selected: issues.length === 0 && duplicateReasons.length === 0
        });
      });

      validationReady = true;
      const readyCount = validatedRows.filter((item) => item.state === "ready").length;
      const duplicateCount = validatedRows.filter((item) => item.state === "duplicate").length;
      const invalidCount = validatedRows.filter((item) => item.state === "invalid").length;
      renderCsvPreview();
      csvValidation.className = readyCount ? "bulk-validation success" : "bulk-validation error";
      csvValidation.textContent = `Validation complete: ${readyCount} ready, ${duplicateCount} duplicate(s) skipped, ${invalidCount} invalid row(s) excluded. Select the rows you want, then import.`;
      showCsvErrors(validatedRows.filter((item) => item.state !== "ready").map((item) => `Row ${item.line}: ${item.reason}.`));
    } catch (error) {
      validationReady = false;
      csvValidation.className = "bulk-validation error";
      csvValidation.textContent = error instanceof Error ? error.message : "CSV validation failed.";
      showCsvErrors([]);
    } finally {
      csvValidateButton.disabled = !selectedCsvFile;
      csvValidateButton.textContent = "1. Validate CSV";
      updateSelectionCount();
    }
  });

  async function getOrCreateCategory(name: string, itemType: "prompt" | "shortcut") {
    const slug = slugify(name);
    const { data: found, error: findError } = await supabase.from("categories").select("id, name, slug, applies_to").eq("slug", slug).maybeSingle();
    if (findError) throw findError;
    if (found) {
      const appliesTo = found.applies_to || "both";
      if (appliesTo !== "both" && appliesTo !== itemType) {
        const { error: updateError } = await supabase.from("categories").update({ applies_to: "both" }).eq("id", found.id);
        if (updateError) throw updateError;
      }
      return found.id;
    }
    const { data, error } = await supabase.from("categories").insert({ name, slug, applies_to: itemType }).select("id").single();
    if (error) {
      // Handle a concurrent import creating the same category slug.
      const { data: raced, error: racedError } = await supabase.from("categories").select("id, applies_to").eq("slug", slug).maybeSingle();
      if (racedError || !raced) throw error;
      if (raced.applies_to !== "both" && raced.applies_to !== itemType) {
        const { error: updateError } = await supabase.from("categories").update({ applies_to: "both" }).eq("id", raced.id);
        if (updateError) throw updateError;
      }
      return raced.id;
    }
    if (!data?.id) throw new Error(`Category was created but no ID was returned: ${name}`);
    return data.id;
  }

  async function getOrCreateTag(name: string) {
    const { data: found, error: findError } = await supabase.from("tags").select("id, name").ilike("name", name).maybeSingle();
    if (findError) throw findError;
    if (found) return found.id;
    const { data, error } = await supabase.from("tags").insert({ name }).select("id").single();
    if (error) {
      const { data: raced, error: racedError } = await supabase.from("tags").select("id").ilike("name", name).maybeSingle();
      if (racedError || !raced) throw error;
      return raced.id;
    }
    if (!data?.id) throw new Error(`Tag was created but no ID was returned: ${name}`);
    return data.id;
  }

  csvImportButton.addEventListener("click", async () => {
    if (!validationReady) return;
    const selected = validatedRows.filter((item) => item.state === "ready" && item.selected);
    if (!selected.length) return;
    csvImportButton.disabled = true;
    csvValidateButton.disabled = true;
    csvImportButton.textContent = "Importing...";
    csvValidation.className = "bulk-validation";
    csvValidation.textContent = `Importing ${selected.length} selected item(s)...`;
    showCsvErrors([]);

    let imported = 0;
    const failed: string[] = [];
    const importedItems = new Set<any>();
    const failedItems = new Set<any>();
    const getSupabaseError = (error: any) => {
      if (!error) return "Unknown database error";
      return [error.message, error.details ? `Details: ${error.details}` : "", error.hint ? `Hint: ${error.hint}` : "", error.code ? `Code: ${error.code}` : ""].filter(Boolean).join(" · ") || String(error);
    };

    for (const item of selected) {
      let insertedId: string | null = null;
      const table = item.item_type === "prompt" ? "prompts" : "shortcuts";
      try {
        const slugBase = slugify(item.item_type === "prompt" ? item.title : item.name);
        const slug = `${slugBase}-${crypto.randomUUID().slice(0, 8)}`;
        let inserted: any;
        if (item.item_type === "prompt") {
          const { data, error } = await supabase.from("prompts").insert({
            slug, title: item.title, content: item.content,
            description: item.description || null, prompt_type: item.prompt_type,
            status: "draft", ai_tools: item.ai_tools
          }).select("id").single();
          if (error) throw new Error(getSupabaseError(error));
          inserted = data;
        } else {
          const { data, error } = await supabase.from("shortcuts").insert({
            slug, name: item.name, description: item.description, status: "draft"
          }).select("id").single();
          if (error) throw new Error(getSupabaseError(error));
          inserted = data;
        }
        if (!inserted?.id) throw new Error(`${item.item_type} was inserted, but Supabase did not return its ID.`);
        insertedId = inserted.id;

        const categoryIds: string[] = [];
        for (const name of item.categories) categoryIds.push(await getOrCreateCategory(name, item.item_type));
        const tagIds: string[] = [];
        for (const name of item.tags) tagIds.push(await getOrCreateTag(name));
        if (categoryIds.length) {
          const relationTable = item.item_type === "prompt" ? "prompt_categories" : "shortcut_categories";
          const foreignKey = item.item_type === "prompt" ? "prompt_id" : "shortcut_id";
          const { error } = await supabase.from(relationTable).insert(categoryIds.map((category_id) => ({ [foreignKey]: insertedId, category_id })));
          if (error) throw new Error(`Category linking failed: ${getSupabaseError(error)}`);
        }
        if (tagIds.length) {
          const relationTable = item.item_type === "prompt" ? "prompt_tags" : "shortcut_tags";
          const foreignKey = item.item_type === "prompt" ? "prompt_id" : "shortcut_id";
          const { error } = await supabase.from(relationTable).insert(tagIds.map((tag_id) => ({ [foreignKey]: insertedId, tag_id })));
          if (error) throw new Error(`Tag linking failed: ${getSupabaseError(error)}`);
        }
        imported++;
        importedItems.add(item);
      } catch (error: any) {
        let message = error?.message || getSupabaseError(error);
        if (insertedId) {
          const foreignKey = item.item_type === "prompt" ? "prompt_id" : "shortcut_id";
          const categoryTable = item.item_type === "prompt" ? "prompt_categories" : "shortcut_categories";
          const tagTable = item.item_type === "prompt" ? "prompt_tags" : "shortcut_tags";
          const { error: categoryCleanupError } = await supabase.from(categoryTable).delete().eq(foreignKey, insertedId);
          const { error: tagCleanupError } = await supabase.from(tagTable).delete().eq(foreignKey, insertedId);
          const { error: cleanupError } = await supabase.from(table).delete().eq("id", insertedId);
          const cleanupErrors = [categoryCleanupError, tagCleanupError, cleanupError].filter(Boolean);
          if (cleanupErrors.length) message += ` · Cleanup failed: ${cleanupErrors.map(getSupabaseError).join("; ")}. Check this ${item.item_type} before retrying.`;
          else message += ` · The incomplete ${item.item_type} record and its links were removed; you can retry this row.`;
        }
        failedItems.add(item);
        failed.push(`Row ${item.line} (${item.label}): ${message}`);
      }
    }

    if (failed.length) showCsvErrors(failed);
    const promptCount = importedItems.size ? Array.from(importedItems).filter((item: any) => item.item_type === "prompt").length : 0;
    const shortcutCount = importedItems.size - promptCount;
    csvValidation.className = imported ? "bulk-validation success" : "bulk-validation error";
    csvValidation.textContent = `${imported} item(s) imported: ${promptCount} prompt(s), ${shortcutCount} shortcut(s). ${failed.length} failed.`;
    if (promptCount) window.dispatchEvent(new CustomEvent("promptvault:prompt-saved"));
    if (shortcutCount) window.dispatchEvent(new CustomEvent("promptvault:shortcut-saved"));

    validatedRows.forEach((item) => {
      if (importedItems.has(item)) {
        item.state = "imported"; item.selected = false; item.reason = "Successfully imported as draft";
      } else if (failedItems.has(item)) {
        item.state = "invalid"; item.selected = false; item.reason = "Import failed. See the detailed error above.";
      }
    });
    renderCsvPreview();
    csvValidateButton.disabled = !selectedCsvFile;
    csvValidateButton.textContent = "1. Validate CSV";
    csvImportButton.textContent = "2. Import selected";
  });

  $("#shortcut-search").addEventListener("input", () => { shortcutPage = 1; renderShortcuts(); });
  $("#shortcut-status-filter").addEventListener("change", () => { shortcutPage = 1; renderShortcuts(); });
  $("#shortcut-prev-page").addEventListener("click", () => { shortcutPage--; renderShortcuts(); });
  $("#shortcut-next-page").addEventListener("click", () => { shortcutPage++; renderShortcuts(); });

  $("#refresh-button").addEventListener("click", loadDashboard);
  $("#logout-button").addEventListener("click", async () => {
    await supabase.auth.signOut();
    window.location.reload();
  });
  ["#prompt-search", "#status-filter", "#type-filter"].forEach((selector) => {
    $(selector).addEventListener("input", () => { currentPage = 1; renderPrompts(); });
  });
  $("#prev-page").addEventListener("click", () => { currentPage--; renderPrompts(); });
  $("#next-page").addEventListener("click", () => { currentPage++; renderPrompts(); });
  window.addEventListener("promptvault:prompt-saved", () => { void loadDashboard(); });
  window.addEventListener("promptvault:shortcut-saved", () => { void loadDashboard(); });

  async function initializeDashboard() {
    const { data: { user }, error } = await supabase.auth.getUser();

    if (error || !user) {
      window.location.replace("/admin-login");
      return;
    }

    $("#admin-email").textContent = user.email || "";
    await loadDashboard();
  }

  initializeDashboard();
</script>
