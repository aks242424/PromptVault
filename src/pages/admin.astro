  /* Colorful CSV import center */
  .csv-import-panel { position:relative; overflow:hidden; margin-top:25px; padding:30px; border:1px solid #334155; border-radius:24px; background:radial-gradient(ellipse at 5% 0%,#7c3aed20,transparent 35%),radial-gradient(ellipse at 100% 10%,#06b6d420,transparent 35%),linear-gradient(145deg,#111827,#0b1019 65%,#17111e); box-shadow:0 25px 70px #0006; }
  .csv-import-header { display:flex; justify-content:space-between; align-items:center; gap:20px; margin-bottom:25px; }
