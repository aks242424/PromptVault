  .csv-feature strong,.csv-feature small { display:block; }.csv-feature strong { color:#f1f5f9; font-size:12px; }.csv-feature small { margin-top:5px; color:#94a3b8; font-size:10px; line-height:1.5; }
  .csv-feature-purple { border-color:#8b5cf644; }.csv-feature-purple .csv-feature-icon { color:#c4b5fd; background:#8b5cf626; }.csv-feature-cyan { border-color:#06b6d444; }.csv-feature-cyan .csv-feature-icon { color:#67e8f9; background:#06b6d426; }.csv-feature-orange { border-color:#f9731644; }.csv-feature-orange .csv-feature-icon { color:#fdba74; background:#f9731626; }
  .csv-format-card,.csv-upload-card { padding:22px; border:1px solid #ffffff16; border-radius:18px; background:linear-gradient(145deg,#0b111be8,#101722e8); }
  .csv-format-heading,.csv-upload-heading { display:flex; align-items:center; gap:13px; }.csv-format-heading { justify-content:space-between; margin-bottom:17px; }.csv-format-heading>div,.csv-upload-heading { display:flex; align-items:center; gap:12px; }
  .csv-step { display:grid; place-items:center; width:34px; height:34px; flex-shrink:0; border:1px solid #22d3ee55; border-radius:10px; background:#06b6d41c; color:#67e8f9; font-size:11px; font-weight:850; }
  .csv-format-heading strong,.csv-upload-heading strong,.csv-format-heading small,.csv-upload-heading small { display:block; }.csv-format-heading strong,.csv-upload-heading strong { color:#f1f5f9; font-size:14px; }.csv-format-heading small,.csv-upload-heading small { margin-top:4px; color:#94a3b8; font-size:11px; }
  .csv-format-badge { padding:7px 10px; border:1px solid #a78bfa44; border-radius:30px; background:#8b5cf61a; color:#c4b5fd; font-size:9px; font-weight:800; letter-spacing:.12em; }
  .csv-columns-code { overflow-x:auto; padding:16px; border:1px solid #22d3ee35; border-radius:12px; background:#06b6d40b; color:#67e8f9; font-family:monospace; font-size:12px; line-height:1.8; white-space:nowrap; }
  .csv-rules-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin:16px 0; }.csv-rule { display:flex; gap:11px; padding:13px; border:1px solid #ffffff12; border-radius:12px; background:#ffffff05; }.csv-rule-dot { width:9px; height:9px; flex-shrink:0; margin-top:4px; border-radius:50%; }.csv-rule-dot.purple { background:#a78bfa; box-shadow:0 0 12px #a78bfa; }.csv-rule-dot.cyan { background:#22d3ee; box-shadow:0 0 12px #22d3ee; }.csv-rule strong { color:#e2e8f0; font-size:11px; }.csv-rule p { margin:5px 0 0; color:#94a3b8; font-size:10px; }
  .csv-instructions { display:grid; grid-template-columns:1fr 1fr; gap:9px 20px; padding:15px 0; border-top:1px solid #ffffff12; }.csv-instructions p { margin:0; color:#aab8ca; font-size:11px; line-height:1.7; }.csv-instructions b { color:#e2e8f0; }.csv-instructions code { padding:2px 5px; border-radius:5px; background:#8b5cf61a; color:#c4b5fd; }
  .csv-sample { display:grid; gap:9px; margin-top:8px; padding:15px; border:1px solid #ffffff16; border-radius:12px; background:#070c13; }.csv-sample-title { color:#fbbf24; font-size:10px; font-weight:850; letter-spacing:.13em; }.csv-sample code { overflow-x:auto; color:#67e8f9; font-family:monospace; font-size:10px; line-height:1.8; white-space:nowrap; }
  .csv-upload-card { margin-top:17px; }.csv-upload-heading { margin-bottom:18px; }.csv-dropzone { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; min-height:165px; padding:20px; border:1px dashed #22d3ee77; border-radius:15px; background:radial-gradient(ellipse at center,#0891b220,transparent 70%),#06b6d408; cursor:pointer; transition:.2s; }.csv-dropzone:hover { border-color:#67e8f9; background-color:#06b6d415; transform:translateY(-2px); }.csv-upload-icon { display:grid; place-items:center; width:45px; height:45px; border:1px solid #22d3ee55; border-radius:14px; background:#06b6d426; color:#67e8f9; font-size:25px; }.csv-dropzone strong { color:#f1f5f9; font-size:13px; }.csv-dropzone small { color:#94a3b8; font-size:10px; }.csv-dropzone input { position:absolute; width:1px; height:1px; opacity:0; pointer-events:none; }
  .csv-file-name { margin:12px 0; color:#94a3b8; font-size:11px; }.csv-action-row { display:flex; flex-wrap:wrap; gap:10px; }.csv-validate-btn,.csv-import-btn { display:inline-flex; align-items:center; justify-content:center; gap:10px; min-height:45px; padding:12px 19px; border-radius:11px; font-size:12px; font-weight:800; cursor:pointer; transition:.2s; }.csv-validate-btn { border:1px solid #8b5cf677; background:linear-gradient(110deg,#7c3aed35,#4f46e535); color:#ddd6fe; }.csv-import-btn { border:1px solid #06b6d477; background:linear-gradient(110deg,#0891b2,#2563eb); color:white; box-shadow:0 7px 25px #0891b233; }.csv-validate-btn:hover,.csv-import-btn:hover { transform:translateY(-2px); filter:brightness(1.15); }.csv-validate-btn:disabled,.csv-import-btn:disabled { opacity:.4; cursor:not-allowed; transform:none; }.csv-import-panel .bulk-validation,.csv-import-panel .bulk-errors,.csv-import-panel .bulk-preview { margin-top:15px; }
  @media(max-width:700px) { .csv-import-panel { padding:18px; }.csv-import-header { align-items:flex-start; flex-direction:column; }.csv-feature-grid { grid-template-columns:1fr; }.csv-rules-grid,.csv-instructions { grid-template-columns:1fr; }.csv-format-card,.csv-upload-card { padding:15px; } }
  @media(max-width:460px) { .csv-action-row { flex-direction:column; }.csv-action-row button { width:100%; }.csv-format-badge { display:none; } }

  [hidden] { display: none !important; }
  @media (max-width: 760px) {
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .toolbar { grid-template-columns: 1fr 1fr; }
    .toolbar input { grid-column: 1 / -1; }
    .shortcut-toolbar { grid-template-columns: 1fr 1fr; }
    .shortcut-toolbar input { grid-column: 1 / -1; }
    .admin-table-head, .admin-prompt-row { grid-template-columns: minmax(260px, 1fr) 90px 110px 120px 190px; }
    .dash-header { align-items: flex-start; }
    .admin-shell { padding: 28px 14px 80px; }
  }
  @media (max-width: 460px) {
    .stats-grid { gap: 9px; }
    .stat-card { min-height: 100px; padding: 14px; }
    .stat-card strong { font-size: 26px; }
    .management-panel { padding: 14px; }
    .admin-table-head, .admin-prompt-row { gap: 10px; padding: 12px 14px; }
    .toolbar { grid-template-columns: 1fr; }
    .toolbar input { grid-column: auto; }
    .shortcut-toolbar { grid-template-columns: 1fr; }
    .shortcut-toolbar input { grid-column: auto; }
    .header-actions { flex-direction: column; }
    .csv-columns { grid-template-columns:1fr; }
    .bulk-heading { align-items:flex-start; flex-direction:column; }
    .bulk-panel { padding:16px; }
    .dash-header h1 { font-size: 27px; }
    .login-card { padding: 26px 22px; }
  }
</style>

<script>
  import { supabase } from "../lib/supabase.js";

  const $ = <T extends HTMLElement = HTMLElement>(selector: string): T => {
    const element = document.querySelector<HTMLElement>(selector);
    if (!element) throw new Error(`Required admin element not found: ${selector}`);
    return element as T;
  };

  const dashboard = $<HTMLElement>("#dashboard");
  const promptList = $<HTMLElement>("#prompt-list");
  const dashboardMessage = $<HTMLElement>("#dashboard-message");

  let allPrompts = [];
  let allShortcuts: any[] = [];
  let shortcutPage = 1;
  const shortcutPageSize = 10;
  let currentPage = 1;
  const pageSize = 10;
  const selectedPromptIds = new Set<string>();
  const selectedShortcutIds = new Set<string>();
  let filteredPromptIds: string[] = [];
  let filteredShortcutIds: string[] = [];

  // Keep PostgREST URLs and request payloads small when acting on hundreds of rows.
  const BULK_BATCH_SIZE = 50;
  function chunkIds(ids: string[], size = BULK_BATCH_SIZE) {
    const batches: string[][] = [];
    for (let index = 0; index < ids.length; index += size) {
      batches.push(ids.slice(index, index + size));
    }
    return batches;
  }

  function updateBulkActionBar() {
    const bar = $<HTMLElement>("#bulk-actions");
    const count = selectedPromptIds.size;
    bar.hidden = filteredPromptIds.length === 0 && count === 0;
    $("#bulk-selected-count").textContent = `${count} selected`;
    const selectedPrompts = allPrompts.filter((prompt) => selectedPromptIds.has(prompt.id));
    const hasDrafts = selectedPrompts.some((prompt) => prompt.status !== "published");
    const hasPublished = selectedPrompts.some((prompt) => prompt.status === "published");
    $<HTMLButtonElement>("#bulk-publish-prompts").disabled = !hasDrafts;
    $<HTMLButtonElement>("#bulk-unpublish-prompts").disabled = !hasPublished;
    $<HTMLButtonElement>("#bulk-delete-prompts").disabled = count === 0;
  }

  function renderPrompts() {
    const query = $<HTMLInputElement>("#prompt-search").value.trim().toLowerCase();
    const status = $<HTMLSelectElement>("#status-filter").value;
    const type = $<HTMLSelectElement>("#type-filter").value;
    const filtered = allPrompts.filter((prompt) =>
      (prompt.title || "").toLowerCase().includes(query) &&
      (status === "all" || prompt.status === status) &&
      (type === "all" || prompt.prompt_type === type)
    );
    const pages = Math.max(1, Math.ceil(filtered.length / pageSize));
    currentPage = Math.min(currentPage, pages);
    filteredPromptIds = filtered.map((prompt) => prompt.id);
    for (const id of Array.from(selectedPromptIds)) {
      if (!allPrompts.some((prompt) => prompt.id === id)) selectedPromptIds.delete(id);
    }
    const visible = filtered.slice((currentPage - 1) * pageSize, currentPage * pageSize);
    promptList.replaceChildren();

    if (!visible.length) {
      const empty = document.createElement("p");
      empty.className = "empty-row";
      empty.textContent = "No matching prompts.";
      promptList.append(empty);
    }

    visible.forEach((prompt) => {
      const row = document.createElement("div");
      row.className = "admin-prompt-row";

      row.classList.toggle("is-selected", selectedPromptIds.has(prompt.id));

      const titleWrap = document.createElement("div");
      titleWrap.className = "admin-prompt-name-wrap";

      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.className = "prompt-select-checkbox";
      checkbox.checked = selectedPromptIds.has(prompt.id);
      checkbox.setAttribute("aria-label", `Select ${prompt.title}`);
      checkbox.addEventListener("change", () => {
        if (checkbox.checked) selectedPromptIds.add(prompt.id);
        else selectedPromptIds.delete(prompt.id);
        row.classList.toggle("is-selected", checkbox.checked);
        updateBulkActionBar();
      });

      const title = document.createElement("span");
      title.className = "admin-prompt-name";
      title.textContent = prompt.title;
      titleWrap.append(checkbox, title);

      const type = document.createElement("span");
      type.className = "admin-prompt-meta";
      type.textContent = prompt.prompt_type;

      const statusBadge = document.createElement("span");
      statusBadge.className = `admin-status-pill admin-status-${prompt.status}`;
      statusBadge.textContent = prompt.status;

      const created = document.createElement("span");
      created.className = "shortcut-date";
      created.textContent = prompt.created_at ? new Date(prompt.created_at).toLocaleDateString() : "—";

      const actions = document.createElement("div");
      actions.className = "admin-row-actions";

      const edit = document.createElement("button");
      edit.type = "button";
      edit.className = "edit-action";
      edit.textContent = "Edit";
      edit.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("promptvault:edit-prompt", { detail: { id: prompt.id } }));
        $("#prompt-editor").scrollIntoView({ behavior: "smooth", block: "start" });
      });

      const toggle = document.createElement("button");
      toggle.type = "button";
      toggle.textContent = prompt.status === "published" ? "Unpublish" : "Publish";
      toggle.addEventListener("click", async () => {
        toggle.disabled = true;
        const nextStatus = prompt.status === "published" ? "draft" : "published";
        try {
          const { error } = await supabase.from("prompts").update({ status: nextStatus, updated_at: new Date().toISOString() }).eq("id", prompt.id);
          if (error) throw error;
          dashboardMessage.textContent = `Prompt ${nextStatus === "published" ? "published" : "moved to drafts"}.`;
          await loadDashboard();
        } catch (error) {
          dashboardMessage.textContent = error instanceof Error ? error.message : "Could not update prompt status.";
          toggle.disabled = false;
        }
      });

      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "delete-action";
      remove.textContent = "Delete";
      remove.addEventListener("click", async () => {
        if (!window.confirm(`Permanently delete "${prompt.title}"?`)) return;
        remove.disabled = true;
        try {
          const { data: record, error: readError } = await supabase.from("prompts").select("thumbnail_path").eq("id", prompt.id).single();
          if (readError) throw readError;
          const { error } = await supabase.from("prompts").delete().eq("id", prompt.id);
          if (error) throw error;
          let message = "Prompt deleted.";
          if (record?.thumbnail_path) {
            const { error: storageError } = await supabase.storage.from("prompt-thumbnails").remove([record.thumbnail_path]);
            if (storageError) message = `Prompt deleted. Thumbnail cleanup failed: ${storageError.message}`;
          }
          dashboardMessage.textContent = message;
          await loadDashboard();
        } catch (error) {
          dashboardMessage.textContent = error instanceof Error ? error.message : "Could not delete prompt.";
          remove.disabled = false;
        }
      });

      actions.append(edit, toggle, remove);
      row.append(titleWrap, type, statusBadge, created, actions);
      promptList.append(row);
    });

    $("#prompt-total-label").textContent = `${filtered.length} ${filtered.length === 1 ? "prompt" : "prompts"}`;
    $("#page-label").textContent = `Page ${currentPage} of ${pages}`;
    $<HTMLButtonElement>("#prev-page").disabled = currentPage <= 1;
    $<HTMLButtonElement>("#next-page").disabled = currentPage >= pages;
    updateBulkActionBar();
  }

  async function loadDashboard() {
    dashboardMessage.textContent = "Refreshing...";
    $("#shortcut-message").textContent = "Refreshing shortcuts...";
    const [promptsResult, shortcutsResult, categoriesResult, promptDraftsResult, shortcutDraftsResult, promptsDataResult] = await Promise.all([
      supabase.from("prompts").select("id", { count: "exact", head: true }),
      supabase.from("shortcuts").select("id", { count: "exact", head: true }),
      supabase.from("categories").select("id", { count: "exact", head: true }),
      supabase.from("prompts").select("id", { count: "exact", head: true }).eq("status", "draft"),
      supabase.from("shortcuts").select("id", { count: "exact", head: true }).eq("status", "draft"),
      supabase.from("prompts").select("id, title, prompt_type, status, created_at").order("created_at", { ascending: false })
    ]);

    const shortcutsDataResult = await supabase.from("shortcuts")
      .select("id, name, description, status, created_at")
      .order("created_at", { ascending: false });
    const errors = [promptsResult.error, shortcutsResult.error, categoriesResult.error, promptDraftsResult.error, shortcutDraftsResult.error, promptsDataResult.error, shortcutsDataResult.error].filter(Boolean);
    if (errors.length) {
      const message = errors[0]?.message || "Could not load dashboard data.";
      dashboardMessage.textContent = message;
      $("#shortcut-message").textContent = message;
      return;
    }
    $("#total-prompts").textContent = String(promptsResult.count ?? 0);
    $("#total-shortcuts").textContent = String(shortcutsResult.count ?? 0);
    $("#total-categories").textContent = String(categoriesResult.count ?? 0);
    $("#total-drafts").textContent = String((promptDraftsResult.count ?? 0) + (shortcutDraftsResult.count ?? 0));
    allPrompts = promptsDataResult.data || [];
    allShortcuts = shortcutsDataResult.data || [];
    renderPrompts();
    renderShortcuts();
    dashboardMessage.textContent = "";
    $("#shortcut-message").textContent = "";
  }


  function updateShortcutBulkActionBar() {
    const bar = $("#shortcut-bulk-actions");
    const selected = allShortcuts.filter((item) => selectedShortcutIds.has(item.id));
    bar.hidden = filteredShortcutIds.length === 0 && selected.length === 0;
    $("#shortcut-bulk-selected-count").textContent = `${selected.length} selected`;
    $("#bulk-publish-shortcuts").disabled = !selected.some((item) => item.status !== "published");
    $("#bulk-unpublish-shortcuts").disabled = !selected.some((item) => item.status === "published");
    $("#bulk-delete-shortcuts").disabled = selected.length === 0;
  }

  function renderShortcuts() {
    const list = $("#shortcut-list");
    const query = $("#shortcut-search").value.trim().toLowerCase();
    const status = $("#shortcut-status-filter").value;
    const filtered = allShortcuts.filter((item) => (item.name || "").toLowerCase().includes(query) && (status === "all" || item.status === status));
    const pages = Math.max(1, Math.ceil(filtered.length / shortcutPageSize));
    shortcutPage = Math.min(Math.max(1, shortcutPage), pages);
    filteredShortcutIds = filtered.map((item) => item.id);
    for (const id of Array.from(selectedShortcutIds)) {
      if (!allShortcuts.some((item) => item.id === id)) selectedShortcutIds.delete(id);
    }
    const visible = filtered.slice((shortcutPage - 1) * shortcutPageSize, shortcutPage * shortcutPageSize);
    list.replaceChildren();
    if (!visible.length) {
      const empty = document.createElement("p");
      empty.className = "empty-row";
      empty.textContent = "No matching shortcuts.";
      list.append(empty);
    }
    visible.forEach((shortcut) => {
      const row = document.createElement("div");
      row.className = "admin-shortcut-row";
      row.classList.toggle("is-selected", selectedShortcutIds.has(shortcut.id));
      const nameWrap = document.createElement("div");
      nameWrap.className = "admin-shortcut-name-wrap";
      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.className = "prompt-select-checkbox";
      checkbox.checked = selectedShortcutIds.has(shortcut.id);
      checkbox.setAttribute("aria-label", `Select ${shortcut.name || "shortcut"}`);
      checkbox.addEventListener("change", () => {
        if (checkbox.checked) selectedShortcutIds.add(shortcut.id);
        else selectedShortcutIds.delete(shortcut.id);
        row.classList.toggle("is-selected", checkbox.checked);
        updateShortcutBulkActionBar();
      });
      const name = document.createElement("span");
      name.className = "admin-shortcut-name";
      name.textContent = shortcut.name || "(unnamed shortcut)";
      nameWrap.append(checkbox, name);
      const statusBadge = document.createElement("span");
      statusBadge.className = `admin-status-pill admin-status-${shortcut.status}`;
      statusBadge.textContent = shortcut.status;
      const created = document.createElement("span");
      created.className = "shortcut-date";
      created.textContent = shortcut.created_at ? new Date(shortcut.created_at).toLocaleDateString() : "—";
      const actions = document.createElement("div");
      actions.className = "admin-row-actions";
      const toggle = document.createElement("button");
      toggle.type = "button";
      toggle.textContent = shortcut.status === "published" ? "Unpublish" : "Publish";
      toggle.addEventListener("click", async () => {
        toggle.disabled = true;
        const nextStatus = shortcut.status === "published" ? "draft" : "published";
        try {
          const { error } = await supabase.from("shortcuts").update({ status: nextStatus }).eq("id", shortcut.id);
          if (error) throw error;
          $("#shortcut-message").textContent = `Shortcut ${nextStatus === "published" ? "published" : "moved to drafts"}.`;
          await loadDashboard();
        } catch (error) {
          $("#shortcut-message").textContent = error instanceof Error ? error.message : "Could not update shortcut.";
          toggle.disabled = false;
        }
      });
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "delete-action";
      remove.textContent = "Delete";
      remove.addEventListener("click", async () => {
        if (!window.confirm(`Permanently delete shortcut "${shortcut.name}"? This cannot be undone.`)) return;
        remove.disabled = true;
        try {
          const { error } = await supabase.from("shortcuts").delete().eq("id", shortcut.id);
          if (error) throw error;
          $("#shortcut-message").textContent = "Shortcut deleted.";
          await loadDashboard();
        } catch (error) {
          $("#shortcut-message").textContent = error instanceof Error ? error.message : "Could not delete shortcut.";
          remove.disabled = false;
        }
      });
      actions.append(toggle, remove);
      row.append(nameWrap, statusBadge, created, actions);
      list.append(row);
    });
    $("#shortcut-total-label").textContent = `${filtered.length} ${filtered.length === 1 ? "shortcut" : "shortcuts"}`;
    $("#shortcut-page-label").textContent = `Page ${shortcutPage} of ${pages}`;
