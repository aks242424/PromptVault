  async function runBulkStatusUpdate(nextStatus: "published" | "draft") {
    const ids = Array.from(selectedPromptIds);
    if (!ids.length) return;
    const action = nextStatus === "published" ? "publish" : "move to drafts";
    const verificationWord = nextStatus === "published" ? "PUBLISH" : "UNPUBLISH";
    if (!verifyBulkAction(verificationWord, ids.length)) {
      dashboardMessage.textContent = `${verificationWord} cancelled. No prompts were changed.`;
      return;
