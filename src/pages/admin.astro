  .csv-template-btn:hover { transform:translateY(-2px); border-color:#a78bfa; box-shadow:0 8px 25px #7c3aed30; }
  .csv-feature-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:13px; margin-bottom:20px; }
