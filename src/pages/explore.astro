---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Explore — PromptVault"
  description="Explore published AI prompts and creative shortcuts."
>
  <main class="explore-page">
    <section class="explore-hero">
      <div class="hero-light hero-light-cyan"></div>
      <div class="hero-light hero-light-orange"></div>
      <div class="hero-inner">
        <span class="eyebrow"><i></i> THE CREATIVE DISCOVERY FEED</span>
        <h1>Ideas meet <span>inspiration.</span></h1>
        <p id="explore-subtitle" class="hero-subtitle">Loading prompts and shortcuts...</p>
        <label class="search-field">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <input id="explore-search" type="search" placeholder="Search prompts, shortcuts, styles..." aria-label="Search library" />
          <kbd>SEARCH</kbd>
        </label>
      </div>
      <div class="hero-rule"></div>
    </section>

    <section class="collection-section">
      <div class="toolbar">
        <div id="type-filters" class="filter-list" aria-label="Filter by content type">
          <button data-filter="all" class="filter-button active" aria-pressed="true">All <span id="all-total">0</span></button>
          <button data-filter="prompt" class="filter-button" aria-pressed="false">Prompts</button>
          <button data-filter="shortcut" class="filter-button" aria-pressed="false">Shortcuts</button>
          <button data-filter="image" class="filter-button" aria-pressed="false">Image</button>
          <button data-filter="video" class="filter-button" aria-pressed="false">Video</button>
        </div>
        <label class="category-select-wrap">
          <span>CATEGORY</span>
          <select id="category-filter" aria-label="Filter by category">
            <option value="all">All categories</option>
          </select>
        </label>
      </div>

      <div class="results-heading">
        <div>
          <span class="results-kicker">COLLECTION</span>
          <h2>Discover content<span>.</span></h2>
        </div>
        <p><strong id="result-count">0</strong> results</p>
      </div>

      <div id="content-grid" class="content-grid" aria-live="polite">
        <p class="load-state">Loading prompts and shortcuts...</p>
      </div>
      <div id="empty-state" class="empty-state hidden">
        <div class="empty-symbol">⌕</div>
        <h3 id="empty-title">No matching results</h3>
        <button id="reset-filters" type="button">Clear filters <span>↗</span></button>
      </div>
      <p id="explore-error" class="load-error hidden" role="alert"></p>
    </section>
  </main>

  <script>
    import { supabase } from "../lib/supabase.js";

    const searchInput = document.querySelector<HTMLInputElement>("#explore-search");
    const categorySelect = document.querySelector<HTMLSelectElement>("#category-filter");
    const grid = document.querySelector<HTMLElement>("#content-grid");
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-button"));
    const resultCount = document.querySelector<HTMLElement>("#result-count");
    const allTotal = document.querySelector<HTMLElement>("#all-total");
    const subtitle = document.querySelector<HTMLElement>("#explore-subtitle");
    const emptyState = document.querySelector<HTMLElement>("#empty-state");
    const emptyTitle = document.querySelector<HTMLElement>("#empty-title");
    const errorMessage = document.querySelector<HTMLElement>("#explore-error");
    const resetButton = document.querySelector<HTMLButtonElement>("#reset-filters");

    const typeLabels: Record<string, string> = {
      shortcut: "Shortcut",
      image: "Image prompt",
      video: "Video prompt",
      other: "Prompt",
    };

    let items: any[] = [];
    let activeType = "all";

    function makeElement<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className?: string,
      text?: string
    ): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function renderCard(item: any, index: number) {
      const accent = item.type === "shortcut" ? "orange" : item.type === "image" ? "cyan" : item.type === "video" ? "violet" : "mint";
      const card = makeElement("article", `content-card accent-${accent}`);
      const searchable = [
        item.title,
        item.type === "shortcut" ? "shortcut command" : "prompt",
        item.description,
        item.categories.join(" "),
        item.tags.join(" "),
      ].filter(Boolean).join(" ").toLowerCase();

      card.dataset.type = item.type;
      card.dataset.categories = JSON.stringify(item.categories);
      card.dataset.search = searchable;

      const top = makeElement("div", "card-topline");
      top.append(makeElement("span", "type-mark", item.type === "shortcut" ? "/" : item.type === "image" ? "✳" : item.type === "video" ? "▶" : "✦"));
      top.append(makeElement("span", "card-number", String(index + 1).padStart(2, "0")));
      card.append(top);

      const meta = makeElement("div", "card-meta");
      meta.append(makeElement("span", "category-name", item.categories[0] || typeLabels[item.type]));
      meta.append(makeElement("span", "type-name", typeLabels[item.type]));
      card.append(meta);

      if (item.type !== "shortcut" && item.thumbnailUrl) {
        const thumbnail = makeElement("img", "content-card-thumbnail") as HTMLImageElement;
        thumbnail.src = item.thumbnailUrl;
        thumbnail.alt = `${item.title} thumbnail`;
        thumbnail.loading = "lazy";
        thumbnail.decoding = "async";
        thumbnail.addEventListener("error", () => thumbnail.remove());
        card.append(thumbnail);
      }

      card.append(makeElement("h3", "", item.title));
      card.append(makeElement("p", "card-description", item.description || ""));

      const tagList = makeElement("div", "tag-list");
      item.tags.forEach((tag: string) => tagList.append(makeElement("span", "", `#${tag}`)));
      card.append(tagList);

      const link = makeElement("a", "card-link") as HTMLAnchorElement;
      link.href = item.href;
      link.append(makeElement("span", "", "Explore content"));
      link.append(makeElement("span", "link-arrow", "↗"));
      card.append(link);

      return card;
    }

    function renderItems() {
      if (!grid) return;
      grid.replaceChildren();
      items.forEach((item, index) => grid.append(renderCard(item, index)));
      if (allTotal) allTotal.textContent = String(items.length);
      if (subtitle) subtitle.textContent = `${items.length} published resources, ready to discover.`;
      updateResults();
    }

    function populateCategories() {
      if (!categorySelect) return;
      const selected = categorySelect.value;
      const names = [...new Set(items.flatMap((item) => item.categories))].sort((a, b) => a.localeCompare(b));
      categorySelect.replaceChildren(new Option("All categories", "all"));
      names.forEach((name) => categorySelect.add(new Option(name, name)));
      categorySelect.value = names.includes(selected) ? selected : "all";
    }

    function updateResults() {
      const query = searchInput?.value.trim().toLowerCase() || "";
      const category = categorySelect?.value || "all";
      let visibleCount = 0;

      Array.from(grid?.querySelectorAll<HTMLElement>(".content-card") || []).forEach((card) => {
        const categories = JSON.parse(card.dataset.categories || "[]");
        const itemType = card.dataset.type || "other";
        const typeMatches = activeType === "all" ||
          (activeType === "prompt" && itemType !== "shortcut") ||
          (activeType === "shortcut" && itemType === "shortcut") ||
          itemType === activeType;
        const visible =
          (card.dataset.search || "").includes(query) &&
          typeMatches &&
          (category === "all" || categories.includes(category));
        card.classList.toggle("hidden", !visible);
        if (visible) visibleCount++;
      });

      if (resultCount) resultCount.textContent = String(visibleCount);
      emptyState?.classList.toggle("hidden", visibleCount !== 0);
      if (emptyTitle) emptyTitle.textContent = items.length ? "No matching results" : "No published resources yet";
    }

    function updateActiveButton() {
      filterButtons.forEach((button) => {
        const active = button.dataset.filter === activeType;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    async function loadExploreItems() {
      if (!grid) return;
      grid.replaceChildren(makeElement("p", "load-state", "Loading prompts and shortcuts..."));
      errorMessage?.classList.add("hidden");

      try {
        const [promptResult, shortcutResult] = await Promise.all([
          supabase
            .from("prompts")
            .select("id, title, description, prompt_type, thumbnail_path, created_at")
            .eq("status", "published")
            .order("created_at", { ascending: false }),
          supabase
            .from("shortcuts")
            .select("id, name, description, created_at")
            .eq("status", "published")
            .order("created_at", { ascending: false }),
        ]);

        if (promptResult.error) throw promptResult.error;
        if (shortcutResult.error) throw shortcutResult.error;

        const promptRows = promptResult.data || [];
        const shortcutRows = shortcutResult.data || [];
        const promptIds = promptRows.map((row: any) => row.id);
        const shortcutIds = shortcutRows.map((row: any) => row.id);

        const relationQueries = await Promise.all([
          promptIds.length
            ? supabase.from("prompt_categories").select("prompt_id, category_id").in("prompt_id", promptIds)
            : Promise.resolve({ data: [], error: null }),
          promptIds.length
            ? supabase.from("prompt_tags").select("prompt_id, tag_id").in("prompt_id", promptIds)
            : Promise.resolve({ data: [], error: null }),
          shortcutIds.length
            ? supabase.from("shortcut_categories").select("shortcut_id, category_id").in("shortcut_id", shortcutIds)
            : Promise.resolve({ data: [], error: null }),
          shortcutIds.length
            ? supabase.from("shortcut_tags").select("shortcut_id, tag_id").in("shortcut_id", shortcutIds)
            : Promise.resolve({ data: [], error: null }),
        ]);

        const relationError = relationQueries.find((result: any) => result.error)?.error;
        if (relationError) throw relationError;

        const promptCategoryRows = relationQueries[0].data || [];
        const promptTagRows = relationQueries[1].data || [];
        const shortcutCategoryRows = relationQueries[2].data || [];
        const shortcutTagRows = relationQueries[3].data || [];

        const categoryIds = [...new Set([
          ...promptCategoryRows.map((row: any) => row.category_id),
          ...shortcutCategoryRows.map((row: any) => row.category_id),
        ])];
        const tagIds = [...new Set([
          ...promptTagRows.map((row: any) => row.tag_id),
          ...shortcutTagRows.map((row: any) => row.tag_id),
        ])];

        const [categoryResult, tagResult] = await Promise.all([
          categoryIds.length
            ? supabase.from("categories").select("id, name").in("id", categoryIds)
            : Promise.resolve({ data: [], error: null }),
          tagIds.length
            ? supabase.from("tags").select("id, name").in("id", tagIds)
            : Promise.resolve({ data: [], error: null }),
        ]);

        if (categoryResult.error) throw categoryResult.error;
        if (tagResult.error) throw tagResult.error;

        const categoryNames = new Map((categoryResult.data || []).map((row: any) => [row.id, row.name]));
        const tagNames = new Map((tagResult.data || []).map((row: any) => [row.id, row.name]));

        const promptItems = promptRows.map((row: any) => {
          const thumbnailPath = row.thumbnail_path || null;
          const thumbnailUrl = thumbnailPath
            ? supabase.storage.from("prompt-thumbnails").getPublicUrl(thumbnailPath).data?.publicUrl || null
            : null;

          return {
          title: row.title,
          description: row.description || "",
          type: row.prompt_type,
          thumbnailUrl,
          categories: promptCategoryRows
            .filter((rel: any) => rel.prompt_id === row.id)
            .map((rel: any) => categoryNames.get(rel.category_id))
            .filter(Boolean),
          tags: promptTagRows
            .filter((rel: any) => rel.prompt_id === row.id)
            .map((rel: any) => tagNames.get(rel.tag_id))
            .filter(Boolean),
          href: "/prompts",
          };
        });

        const shortcutItems = shortcutRows.map((row: any) => ({
          title: row.name,
          description: row.description || "",
          type: "shortcut",
          categories: shortcutCategoryRows
            .filter((rel: any) => rel.shortcut_id === row.id)
            .map((rel: any) => categoryNames.get(rel.category_id))
            .filter(Boolean),
          tags: shortcutTagRows
            .filter((rel: any) => rel.shortcut_id === row.id)
            .map((rel: any) => tagNames.get(rel.tag_id))
            .filter(Boolean),
          href: "/shortcuts",
        }));

        // Mix both published collections and reshuffle on every page load/refresh.
        const mixedItems = [...promptItems, ...shortcutItems];
        for (let i = mixedItems.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [mixedItems[i], mixedItems[j]] = [mixedItems[j], mixedItems[i]];
        }
        items = mixedItems;
        populateCategories();
        renderItems();
      } catch (error) {
        console.error("Explore library load failed:", error);
        grid.replaceChildren();
        emptyState?.classList.add("hidden");
        if (errorMessage) {
          errorMessage.textContent = "Explore is temporarily unavailable. Please try again later.";
          errorMessage.classList.remove("hidden");
        }
        if (subtitle) subtitle.textContent = "Published resources could not be loaded.";
        if (allTotal) allTotal.textContent = "0";
        if (resultCount) resultCount.textContent = "0";
      }
    }

    searchInput?.addEventListener("input", updateResults);
    categorySelect?.addEventListener("change", updateResults);

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeType = button.dataset.filter || "all";
        updateActiveButton();
        updateResults();
      });
    });

    resetButton?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      if (categorySelect) categorySelect.value = "all";
      activeType = "all";
      updateActiveButton();
      updateResults();
    });

    loadExploreItems();
  </script>
</MainLayout>

<style is:global>
  .explore-page {
    min-height: 100vh;
    padding-bottom: 100px;
    color: #f3f2f7;
  }

  .explore-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 78px 24px 65px;
    border-bottom: 1px solid rgba(255,255,255,.07);
    background:
      linear-gradient(180deg,rgba(10,11,18,.28),rgba(8,9,14,.94)),
      radial-gradient(ellipse at 18% 0%,rgba(124,58,237,.19),transparent 42%),
      radial-gradient(ellipse at 82% 8%,rgba(249,115,22,.15),transparent 40%);
    text-align: center;
  }

  .explore-hero::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background:
      linear-gradient(90deg,transparent 0 13%,rgba(255,255,255,.025) 13.2%,transparent 13.8% 27%,rgba(255,95,55,.09) 27.2%,transparent 28% 72%,rgba(255,255,255,.025) 72.2%,transparent 73% 87%,rgba(255,83,48,.11) 87.2%,transparent 88%),
      radial-gradient(rgba(255,255,255,.16) .65px,transparent .8px);
    background-size: auto,19px 19px;
    opacity: .65;
  }

  .hero-light {
    position: absolute;
    z-index: -1;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }

  .hero-light-cyan {
    top: -160px;
    left: 25%;
    background: rgba(6,182,212,.14);
  }

  .hero-light-orange {
    top: -120px;
    right: 15%;
    background: rgba(249,115,22,.12);
  }

  .hero-inner {
    position: relative;
    width: min(100%,780px);
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 13px;
    border: 1px solid rgba(103,232,249,.22);
    border-radius: 999px;
    background: rgba(34,211,238,.055);
    color: #8ce8f2;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .12em;
  }

  .eyebrow i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #67e8f9;
    box-shadow: 0 0 10px #67e8f9;
  }

  .explore-hero h1 {
    margin: 24px 0 0;
    color: #f4f2f7;
    font-family: "Space Grotesk",sans-serif;
    font-size: clamp(42px,6vw,66px);
    font-weight: 600;
    letter-spacing: -.065em;
    line-height: 1.08;
  }

  .explore-hero h1 span {
    background: linear-gradient(100deg,#78e6d0,#8ca7ff 48%,#ffad77);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero-subtitle {
    margin: 17px 0 0;
    color: #999aa7;
    font-size: 14px;
  }

  .search-field {
    display: flex;
    width: min(100%,660px);
    min-height: 61px;
    align-items: center;
    gap: 13px;
    margin: 34px auto 0;
    padding: 8px 16px;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 15px;
    background: rgba(24,25,32,.82);
    box-shadow: 0 16px 48px rgba(0,0,0,.25),inset 0 1px 0 rgba(255,255,255,.045);
    backdrop-filter: blur(20px);
    transition: border-color .2s ease,box-shadow .2s ease;
  }

  .search-field:focus-within {
    border-color: rgba(103,232,249,.5);
    box-shadow: 0 0 0 3px rgba(34,211,238,.07),0 16px 48px rgba(0,0,0,.3);
  }

  .search-field svg {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    fill: none;
    stroke: #67c9dc;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .search-field input {
    width: 100%;
    min-width: 0;
    height: 42px;
    border: 0;
    outline: none;
    background: transparent;
    color: #f4f3f7;
    font-size: 13px;
    box-shadow: none;
  }

  .search-field input:focus {
    border: 0;
    outline: none;
    box-shadow: none;
  }

  .search-field input::placeholder {
    color: #777985;
  }

  .search-field kbd {
    flex-shrink: 0;
    color: #727481;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .08em;
  }

  .hero-rule {
    position: absolute;
    right: 5%;
    bottom: 0;
    left: 5%;
    height: 1px;
    background: linear-gradient(90deg,transparent,rgba(103,232,249,.25),rgba(251,146,60,.22),transparent);
  }

  .collection-section {
    width: min(100% - 48px,1250px);
    margin: 0 auto;
    padding-top: 44px;
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 45px;
  }

  .filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-button {
    min-height: 39px;
    padding: 0 15px;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 10px;
    background: rgba(255,255,255,.025);
    color: #a3a3af;
    font-size: 11px;
    transition: .2s ease;
  }

  .filter-button:hover {
    border-color: rgba(103,232,249,.35);
    color: #e8faff;
  }

  .filter-button.active {
    border-color: rgba(103,232,249,.4);
    background: linear-gradient(110deg,rgba(8,145,178,.23),rgba(103,232,249,.10));
    color: #a5f3fc;
    box-shadow: 0 5px 20px rgba(6,182,212,.08);
  }

  .filter-button span {
    margin-left: 6px;
    color: #67e8f9;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
  }

  .category-select-wrap {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .category-select-wrap > span {
    color: #777985;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .1em;
  }

  .category-select-wrap select {
    min-width: 160px;
    min-height: 40px;
    padding: 0 33px 0 12px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 10px;
    background-color: #17181e;
    color: #d1d0da;
    font-size: 11px;
  }

  .results-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .results-kicker {
    color: #fbad70;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .14em;
  }

  .results-heading h2 {
    margin: 7px 0 0;
    color: #f0eef4;
    font-family: "Space Grotesk",sans-serif;
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -.045em;
  }

  .results-heading h2 span {
    color: #fb923c;
  }

  .results-heading > p {
    margin: 0 0 3px;
    color: #858692;
    font-size: 11px;
  }

  .results-heading > p strong {
    color: #f6b47f;
    font-family: "JetBrains Mono",monospace;
    font-weight: 500;
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 16px;
  }

  .content-card {
    --accent: #b69aff;
    --accent-rgb: 167,139,250;
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 285px;
    flex-direction: column;
    overflow: hidden;
    padding: 21px;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 16px;
    background: linear-gradient(145deg,#1b1c23,#121319 82%);
    box-shadow: 0 13px 35px rgba(0,0,0,.19),inset 0 1px 0 rgba(255,255,255,.035);
    transition: transform .22s ease,border-color .22s ease,box-shadow .22s ease;
  }

  .accent-violet {
    --accent: #b69aff;
    --accent-rgb: 167,139,250;
  }

  .accent-cyan {
    --accent: #67e8f9;
    --accent-rgb: 34,211,238;
  }

  .accent-mint {
    --accent: #6ee7b7;
    --accent-rgb: 110,231,183;
  }

  .accent-orange {
    --accent: #fdba74;
    --accent-rgb: 251,146,60;
  }

  .content-card::after {
    position: absolute;
    right: -75px;
    bottom: -110px;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: rgba(var(--accent-rgb),.12);
    content: "";
    filter: blur(65px);
    opacity: .45;
    pointer-events: none;
    transition: opacity .22s ease;
  }

  .content-card:hover {
    transform: translateY(-5px);
    border-color: rgba(var(--accent-rgb),.4);
    box-shadow: 0 20px 45px rgba(0,0,0,.32),0 0 24px rgba(var(--accent-rgb),.06);
  }

  .content-card:hover::after {
    opacity: .9;
  }

  .card-topline,.card-meta,.card-link {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .type-mark {
    width: 39px;
    height: 39px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(var(--accent-rgb),.2);
    border-radius: 11px;
    background: rgba(var(--accent-rgb),.11);
    color: var(--accent);
    font-family: "Space Grotesk",sans-serif;
    font-size: 20px;
  }

