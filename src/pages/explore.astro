---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Explore — PromptVault"
  description="Explore published AI prompts and creative shortcuts."
>
  <main class="explore-page">
    <section class="explore-hero">
      <div class="hero-light hero-light-cyan"></div>
      <div class="hero-light hero-light-orange"></div>
      <div class="hero-inner">
        <span class="eyebrow"><i></i> THE CREATIVE DISCOVERY FEED</span>
        <h1>Ideas meet <span>inspiration.</span></h1>
        <p id="explore-subtitle" class="hero-subtitle">Loading prompts and shortcuts...</p>
        <label class="search-field">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <input id="explore-search" type="search" placeholder="Search prompts, shortcuts, styles..." aria-label="Search library" />
          <kbd>SEARCH</kbd>
        </label>
      </div>
      <div class="hero-rule"></div>
    </section>

    <section class="collection-section">
      <div class="toolbar">
        <div id="type-filters" class="filter-list" aria-label="Filter by content type">
          <button data-filter="all" class="filter-button active" aria-pressed="true">All <span id="all-total">0</span></button>
          <button data-filter="prompt" class="filter-button" aria-pressed="false">Prompts</button>
          <button data-filter="shortcut" class="filter-button" aria-pressed="false">Shortcuts</button>
          <button data-filter="image" class="filter-button" aria-pressed="false">Image</button>
          <button data-filter="video" class="filter-button" aria-pressed="false">Video</button>
        </div>
        <label class="category-select-wrap">
          <span>CATEGORY</span>
          <select id="category-filter" aria-label="Filter by category">
            <option value="all">All categories</option>
          </select>
        </label>
      </div>

      <div class="results-heading">
        <div>
          <span class="results-kicker">COLLECTION</span>
          <h2>Discover content<span>.</span></h2>
        </div>
        <p><strong id="result-count">0</strong> results</p>
      </div>

      <div id="content-grid" class="content-grid" aria-live="polite">
        <p class="load-state">Loading prompts and shortcuts...</p>
      </div>
      <div id="empty-state" class="empty-state hidden">
        <div class="empty-symbol">⌕</div>
        <h3 id="empty-title">No matching results</h3>
        <button id="reset-filters" type="button">Clear filters <span>↗</span></button>
      </div>
      <p id="explore-error" class="load-error hidden" role="alert"></p>
    </section>
  </main>

  <script>
    import { supabase } from "../lib/supabase.js";

    type PromptRow = {
      id: string;
      title: string;
      description: string | null;
      prompt_type: string | null;
      created_at?: string;
    };
    type ShortcutRow = {
      id: string;
      name: string;
      description: string | null;
      created_at?: string;
    };
    type RelationRow = { prompt_id?: string; shortcut_id?: string; category_id?: string; tag_id?: string };
    type ExploreItem = {
      id: string;
      title: string;
      description: string;
      type: "shortcut" | "image" | "video" | "other";
      thumbnailUrl?: string | null;
      categories: string[];
      tags: string[];
      href: string;
    };

    const searchInput = document.querySelector<HTMLInputElement>("#explore-search");
    const categorySelect = document.querySelector<HTMLSelectElement>("#category-filter");
    const grid = document.querySelector<HTMLElement>("#content-grid");
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-button"));
    const resultCount = document.querySelector<HTMLElement>("#result-count");
    const allTotal = document.querySelector<HTMLElement>("#all-total");
    const subtitle = document.querySelector<HTMLElement>("#explore-subtitle");
    const emptyState = document.querySelector<HTMLElement>("#empty-state");
    const emptyTitle = document.querySelector<HTMLElement>("#empty-title");
    const errorMessage = document.querySelector<HTMLElement>("#explore-error");
    const resetButton = document.querySelector<HTMLButtonElement>("#reset-filters");
    const initialSearch = new URLSearchParams(window.location.search).get("q") || "";
    if (searchInput) searchInput.value = initialSearch;

    const typeLabels: Record<string, string> = {
      shortcut: "Shortcut",
      image: "Image prompt",
      video: "Video prompt",
      other: "Prompt",
    };
    const accents = ["orange", "cyan", "violet", "mint", "rose", "blue", "lime", "purple"];
    let items: ExploreItem[] = [];
    let activeType = "all";

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = "", text = ""): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    }

    function renderCard(item: ExploreItem, index: number): HTMLElement {
      const card = el("article", `content-card accent-${accents[index % accents.length]}`);
      const searchText = [item.title, item.type, item.description, ...item.categories, ...item.tags].join(" ").toLowerCase();
      card.dataset.type = item.type;
      card.dataset.categories = JSON.stringify(item.categories);
      card.dataset.search = searchText;

      const top = el("div", "card-topline");
      const mark = item.type === "shortcut" ? "/" : item.type === "image" ? "✳" : item.type === "video" ? "▶" : "✦";
      top.append(el("span", "type-mark", mark), el("span", "card-number", String(index + 1).padStart(2, "0")));
      card.append(top);

      const meta = el("div", "card-meta");
      meta.append(el("span", "category-name", item.categories[0] || (item.type === "shortcut" ? "Quick command" : "Creative prompt")));
      if (item.type !== "shortcut") meta.append(el("span", "type-name", typeLabels[item.type] || "Prompt"));
      card.append(meta);

      if (item.thumbnailUrl && item.type !== "shortcut") {
        const image = el("img", "content-card-thumbnail") as HTMLImageElement;
        image.src = item.thumbnailUrl;
        image.alt = `${item.title} preview`;
        image.loading = "lazy";
        image.decoding = "async";
        image.addEventListener("error", () => image.remove(), { once: true });
        card.append(image);
      }
      card.append(el("h3", "", item.title), el("p", "card-description", item.description));

      if (item.tags.length) {
        const tagList = el("div", "tag-list");
        item.tags.slice(0, 5).forEach((tag) => tagList.append(el("span", "", `#${tag}`)));
        card.append(tagList);
      }

      const link = el("a", "card-link") as HTMLAnchorElement;
      link.href = item.href;
      link.append(el("span", "", item.type === "shortcut" ? "Browse shortcuts" : "Browse prompts"), el("span", "link-arrow", "↗"));
      card.append(link);
      return card;
    }

    function updateResults(): void {
      const query = searchInput?.value.trim().toLocaleLowerCase() || "";
      const category = categorySelect?.value || "all";
      let visible = 0;
      grid?.querySelectorAll<HTMLElement>(".content-card").forEach((card) => {
        let categories: string[] = [];
        try { categories = JSON.parse(card.dataset.categories || "[]") as string[]; } catch { categories = []; }
        const type = card.dataset.type || "other";
        const typeMatch = activeType === "all" ||
          (activeType === "prompt" && type !== "shortcut") ||
          (activeType === "shortcut" && type === "shortcut") || type === activeType;
        const show = (card.dataset.search || "").includes(query) && typeMatch && (category === "all" || categories.includes(category));
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      });
      if (resultCount) resultCount.textContent = String(visible);
      emptyState?.classList.toggle("hidden", visible > 0);
      if (emptyTitle) emptyTitle.textContent = items.length ? "No matching results" : "No published resources yet";
    }

    function populateCategories(): void {
      if (!categorySelect) return;
      const previous = categorySelect.value;
      const names = [...new Set(items.flatMap((item) => item.categories))].sort((a, b) => a.localeCompare(b));
      categorySelect.replaceChildren(new Option("All categories", "all"));
      names.forEach((name) => categorySelect.add(new Option(name, name)));
      categorySelect.value = names.includes(previous) ? previous : "all";
    }

    function renderItems(): void {
      if (!grid) return;
      grid.replaceChildren();
      if (!items.length) {
        grid.append(el("p", "load-state", "No published prompts or shortcuts yet."));
      } else {
        const fragment = document.createDocumentFragment();
        items.forEach((item, index) => fragment.append(renderCard(item, index)));
        grid.append(fragment);
      }
      if (allTotal) allTotal.textContent = String(items.length);
      if (subtitle) subtitle.textContent = `${items.length.toLocaleString()} published prompts and shortcuts to explore.`;
      updateResults();
    }

    async function fetchRelations(table: string, foreignKey: "prompt_id" | "shortcut_id", ids: string[], target: "category_id" | "tag_id"): Promise<RelationRow[]> {
      if (!ids.length) return [];
      const output: RelationRow[] = [];
      const batchSize = 150;
      for (let start = 0; start < ids.length; start += batchSize) {
        const batch = ids.slice(start, start + batchSize);
        const { data, error } = await supabase.from(table).select(`${foreignKey}, ${target}`).in(foreignKey, batch);
        if (error) {
          console.warn(`Optional ${table} lookup skipped:`, error.message);
          continue;
        }
        output.push(...((data || []) as RelationRow[]));
      }
      return output;
    }

    async function loadExploreItems(): Promise<void> {
      if (!grid) return;
      grid.replaceChildren(el("p", "load-state", "Loading published library…"));
      errorMessage?.classList.add("hidden");
      try {
        const [promptResult, shortcutResult] = await Promise.all([
          supabase.from("prompts").select("id, title, description, prompt_type, created_at").eq("status", "published").order("created_at", { ascending: false }),
          supabase.from("shortcuts").select("id, name, description, created_at").eq("status", "published").order("created_at", { ascending: false }),
        ]);
        if (promptResult.error) throw new Error(`Prompts: ${promptResult.error.message}`);
        if (shortcutResult.error) throw new Error(`Shortcuts: ${shortcutResult.error.message}`);

        const prompts = (promptResult.data || []) as PromptRow[];
        const shortcuts = (shortcutResult.data || []) as ShortcutRow[];
        const promptIds = prompts.map((row) => row.id);
        const shortcutIds = shortcuts.map((row) => row.id);

        const [promptCategories, promptTags, shortcutCategories, shortcutTags] = await Promise.all([
          fetchRelations("prompt_categories", "prompt_id", promptIds, "category_id"),
          fetchRelations("prompt_tags", "prompt_id", promptIds, "tag_id"),
          fetchRelations("shortcut_categories", "shortcut_id", shortcutIds, "category_id"),
          fetchRelations("shortcut_tags", "shortcut_id", shortcutIds, "tag_id"),
        ]);

        const categoryIds = [...new Set([...promptCategories, ...shortcutCategories].map((r) => r.category_id).filter((v): v is string => Boolean(v)))];
        const tagIds = [...new Set([...promptTags, ...shortcutTags].map((r) => r.tag_id).filter((v): v is string => Boolean(v)))];
        const [categoryResult, tagResult] = await Promise.all([
          categoryIds.length ? supabase.from("categories").select("id, name").in("id", categoryIds) : Promise.resolve({ data: [], error: null }),
          tagIds.length ? supabase.from("tags").select("id, name").in("id", tagIds) : Promise.resolve({ data: [], error: null }),
        ]);
        if (categoryResult.error) console.warn("Category names unavailable:", categoryResult.error.message);
        if (tagResult.error) console.warn("Tag names unavailable:", tagResult.error.message);
        const categoryNames = new Map(((categoryResult.data || []) as { id: string; name: string }[]).map((row) => [row.id, row.name]));
        const tagNames = new Map(((tagResult.data || []) as { id: string; name: string }[]).map((row) => [row.id, row.name]));

        let thumbnailRows: { id: string; thumbnail_path: string | null }[] = [];
        if (promptIds.length) {
          const thumbResult = await supabase.from("prompts").select("id, thumbnail_path").in("id", promptIds);
          if (!thumbResult.error) thumbnailRows = (thumbResult.data || []) as typeof thumbnailRows;
          else console.info("Prompt thumbnails are unavailable:", thumbResult.error.message);
        }
        const thumbnails = new Map(thumbnailRows.map((row) => [row.id, row.thumbnail_path]));

        const promptItems: ExploreItem[] = prompts.map((row) => {
          const path = thumbnails.get(row.id);
          const thumbnailUrl = path ? supabase.storage.from("prompt-thumbnails").getPublicUrl(path).data?.publicUrl || null : null;
          const promptType = String(row.prompt_type || "other").toLowerCase();
          const type: ExploreItem["type"] = promptType === "image" || promptType === "video" ? promptType : "other";
          return {
            id: row.id, title: row.title, description: row.description || "", type, thumbnailUrl,
            categories: promptCategories.filter((r) => r.prompt_id === row.id).map((r) => r.category_id ? categoryNames.get(r.category_id) : undefined).filter((v): v is string => Boolean(v)),
            tags: promptTags.filter((r) => r.prompt_id === row.id).map((r) => r.tag_id ? tagNames.get(r.tag_id) : undefined).filter((v): v is string => Boolean(v)),
            href: "/prompts",
          };
        });
        const shortcutItems: ExploreItem[] = shortcuts.map((row) => ({
          id: row.id, title: row.name, description: row.description || "", type: "shortcut",
          categories: shortcutCategories.filter((r) => r.shortcut_id === row.id).map((r) => r.category_id ? categoryNames.get(r.category_id) : undefined).filter((v): v is string => Boolean(v)),
          tags: shortcutTags.filter((r) => r.shortcut_id === row.id).map((r) => r.tag_id ? tagNames.get(r.tag_id) : undefined).filter((v): v is string => Boolean(v)),
          href: "/shortcuts",
        }));

        items = [...promptItems, ...shortcutItems].sort((a, b) => a.title.localeCompare(b.title));
        populateCategories();
        renderItems();
      } catch (error) {
        console.error("Explore library load failed:", error);
        grid.replaceChildren(el("p", "load-state", "The published library could not be loaded."));
        if (errorMessage) {
          const detail = error instanceof Error ? error.message : "Unknown data loading error";
          errorMessage.textContent = `Library loading error: ${detail}`;
          errorMessage.classList.remove("hidden");
        }
        if (subtitle) subtitle.textContent = "We couldn't connect to the published library.";
        if (allTotal) allTotal.textContent = "0";
        if (resultCount) resultCount.textContent = "0";
      }
    }

    searchInput?.addEventListener("input", updateResults);
    categorySelect?.addEventListener("change", updateResults);
    filterButtons.forEach((button) => button.addEventListener("click", () => {
      activeType = button.dataset.filter || "all";
      filterButtons.forEach((candidate) => {
        const active = candidate === button;
        candidate.classList.toggle("active", active);
        candidate.setAttribute("aria-pressed", String(active));
      });
      updateResults();
    }));
    resetButton?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      if (categorySelect) categorySelect.value = "all";
      activeType = "all";
      filterButtons.forEach((button) => {
        const active = button.dataset.filter === "all";
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      updateResults();
    });

    loadExploreItems();
  </script>
</MainLayout>

<style is:global>
  .explore-page {
    min-height: 100vh;
    padding-bottom: 100px;
    color: #f3f2f7;
  }

  .explore-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 78px 24px 65px;
    border-bottom: 1px solid rgba(255,255,255,.07);
    background:
      linear-gradient(180deg,rgba(10,11,18,.28),rgba(8,9,14,.94)),
      radial-gradient(ellipse at 18% 0%,rgba(124,58,237,.19),transparent 42%),
      radial-gradient(ellipse at 82% 8%,rgba(249,115,22,.15),transparent 40%);
    text-align: center;
  }

  .explore-hero::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background:
      linear-gradient(90deg,transparent 0 13%,rgba(255,255,255,.025) 13.2%,transparent 13.8% 27%,rgba(255,95,55,.09) 27.2%,transparent 28% 72%,rgba(255,255,255,.025) 72.2%,transparent 73% 87%,rgba(255,83,48,.11) 87.2%,transparent 88%),
      radial-gradient(rgba(255,255,255,.16) .65px,transparent .8px);
    background-size: auto,19px 19px;
    opacity: .65;
  }

  .hero-light {
    position: absolute;
    z-index: -1;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }

  .hero-light-cyan {
    top: -160px;
    left: 25%;
    background: rgba(6,182,212,.14);
  }

  .hero-light-orange {
    top: -120px;
    right: 15%;
    background: rgba(249,115,22,.12);
  }

  .hero-inner {
    position: relative;
    width: min(100%,780px);
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 13px;
    border: 1px solid rgba(103,232,249,.22);
    border-radius: 999px;
    background: rgba(34,211,238,.055);
    color: #8ce8f2;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .12em;
  }

  .eyebrow i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #67e8f9;
    box-shadow: 0 0 10px #67e8f9;
  }

  .explore-hero h1 {
    margin: 24px 0 0;
    color: #f4f2f7;
    font-family: "Space Grotesk",sans-serif;
    font-size: clamp(42px,6vw,66px);
    font-weight: 600;
    letter-spacing: -.065em;
    line-height: 1.08;
  }

  .explore-hero h1 span {
    background: linear-gradient(100deg,#78e6d0,#8ca7ff 48%,#ffad77);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero-subtitle {
    margin: 17px 0 0;
    color: #999aa7;
    font-size: 14px;
  }

  .search-field {
    display: flex;
    width: min(100%,660px);
    min-height: 61px;
    align-items: center;
    gap: 13px;
    margin: 34px auto 0;
    padding: 8px 16px;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 15px;
    background: rgba(24,25,32,.82);
    box-shadow: 0 16px 48px rgba(0,0,0,.25),inset 0 1px 0 rgba(255,255,255,.045);
    backdrop-filter: blur(20px);
    transition: border-color .2s ease,box-shadow .2s ease;
  }

  .search-field:focus-within {
    border-color: rgba(103,232,249,.5);
    box-shadow: 0 0 0 3px rgba(34,211,238,.07),0 16px 48px rgba(0,0,0,.3);
  }

  .search-field svg {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    fill: none;
    stroke: #67c9dc;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .search-field input {
    width: 100%;
    min-width: 0;
    height: 42px;
    border: 0;
    outline: none;
    background: transparent;
    color: #f4f3f7;
    font-size: 13px;
    box-shadow: none;
  }

  .search-field input:focus {
    border: 0;
    outline: none;
    box-shadow: none;
  }

  .search-field input::placeholder {
    color: #777985;
  }

  .search-field kbd {
    flex-shrink: 0;
    color: #727481;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .08em;
  }

  .hero-rule {
    position: absolute;
    right: 5%;
    bottom: 0;
    left: 5%;
    height: 1px;
    background: linear-gradient(90deg,transparent,rgba(103,232,249,.25),rgba(251,146,60,.22),transparent);
  }

  .collection-section {
    width: min(100% - 64px,1450px);
    margin: 0 auto;
    padding-top: 44px;
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 45px;
  }

  .filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-button {
    min-height: 39px;
    padding: 0 15px;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 10px;
    background: rgba(255,255,255,.025);
    color: #a3a3af;
    font-size: 11px;
    transition: .2s ease;
  }

  .filter-button:hover {
    border-color: rgba(103,232,249,.35);
    color: #e8faff;
  }

  .filter-button.active {
    border-color: rgba(103,232,249,.4);
    background: linear-gradient(110deg,rgba(8,145,178,.23),rgba(103,232,249,.10));
    color: #a5f3fc;
    box-shadow: 0 5px 20px rgba(6,182,212,.08);
  }

  .filter-button span {
    margin-left: 6px;
    color: #67e8f9;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
  }

  .category-select-wrap {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .category-select-wrap > span {
    color: #777985;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .1em;
  }

  .category-select-wrap select {
    min-width: 160px;
    min-height: 40px;
    padding: 0 33px 0 12px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 10px;
    background-color: #17181e;
    color: #d1d0da;
    font-size: 11px;
  }

  .results-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .results-kicker {
    color: #fbad70;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .14em;
  }

  .results-heading h2 {
    margin: 7px 0 0;
    color: #f0eef4;
    font-family: "Space Grotesk",sans-serif;
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -.045em;
  }

  .results-heading h2 span {
    color: #fb923c;
  }

  .results-heading > p {
    margin: 0 0 3px;
    color: #858692;
    font-size: 11px;
  }

  .results-heading > p strong {
    color: #f6b47f;
    font-family: "JetBrains Mono",monospace;
    font-weight: 500;
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    align-items: stretch;
    gap: 20px;
  }

  .content-card {
    --accent: #b69aff;
    --accent-rgb: 167,139,250;
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 310px;
    flex-direction: column;
    overflow: hidden;
    padding: 25px;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 16px;
    background: linear-gradient(145deg,#1b1c23,#121319 82%);
    box-shadow: 0 13px 35px rgba(0,0,0,.19),inset 0 1px 0 rgba(255,255,255,.035);
    transition: transform .22s ease,border-color .22s ease,box-shadow .22s ease;
  }

  .accent-violet {
    --accent: #b69aff;
    --accent-rgb: 167,139,250;
  }

  .accent-cyan {
    --accent: #67e8f9;
    --accent-rgb: 34,211,238;
  }

  .accent-mint {
    --accent: #6ee7b7;
    --accent-rgb: 110,231,183;
