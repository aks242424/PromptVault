---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Explore — PromptVault"
  description="A handpicked random mix of published AI prompts and shortcuts."
>
  <main class="explore-page">
    <section class="recommend-hero">
      <span class="eyebrow"><i></i> PROMPTVAULT RECOMMENDS</span>
      <h1>Fresh ideas.<br /><span>Randomly discovered.</span></h1>
      <p>Explore 40 randomly selected published prompts and shortcuts.</p>
    </section>

    <section class="recommend-section" aria-labelledby="recommend-title">
      <div class="recommend-heading">
        <div>
          <span class="section-kicker">YOUR DISCOVERY FEED</span>
          <h2 id="recommend-title">Recommended for you<span>.</span></h2>
          <p id="recommend-summary" aria-live="polite">Finding something inspiring…</p>
        </div>
        <button id="shuffle-recommendations" class="shuffle-button" type="button">
          <span aria-hidden="true">⟳</span> Shuffle picks
        </button>
      </div>

      <div id="recommend-grid" class="recommend-grid" aria-live="polite">
        <p class="feed-message">Loading recommendations…</p>
      </div>
      <p id="recommend-error" class="feed-error hidden" role="alert"></p>
    </section>
  </main>

  <script>
    import { supabase } from "../lib/supabase.js";

    type PromptRow = {
      id: string;
      title: string;
      description: string | null;
      prompt_type: string | null;
    };

    type ShortcutRow = {
      id: string;
      name: string;
      description: string | null;
    };

    type RelationRow = {
      prompt_id?: string;
      shortcut_id?: string;
      category_id?: string;
      tag_id?: string;
    };

    type Recommendation = {
      id: string;
      title: string;
      description: string;
      kind: "shortcut" | "image" | "video" | "other";
      category: string;
      tags: string[];
      thumbnailUrl: string | null;
      href: string;
    };

    const PICK_COUNT = 40;
    const grid = document.querySelector<HTMLElement>("#recommend-grid");
    const summary = document.querySelector<HTMLElement>("#recommend-summary");
    const errorBox = document.querySelector<HTMLElement>("#recommend-error");
    const shuffleButton = document.querySelector<HTMLButtonElement>("#shuffle-recommendations");

    let allRecommendations: Recommendation[] = [];

    function makeElement<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className = "",
      text = "",
    ): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    }

    function shuffle<T>(values: T[]): T[] {
      const result = [...values];
      for (let i = result.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [result[i], result[j]] = [result[j], result[i]];
      }
      return result;
    }

    async function fetchRelations(
      table: string,
      foreignKey: "prompt_id" | "shortcut_id",
      ids: string[],
      target: "category_id" | "tag_id",
    ): Promise<RelationRow[]> {
      if (!ids.length) return [];
      const rows: RelationRow[] = [];
      const batchSize = 150;

      for (let offset = 0; offset < ids.length; offset += batchSize) {
        const batch = ids.slice(offset, offset + batchSize);
        const { data, error } = await supabase
          .from(table)
          .select(`${foreignKey},${target}`)
          .in(foreignKey, batch);

        // Category and tag relationships are optional for the recommendation feed.
        if (error) {
          console.warn(`${table} could not be loaded:`, error.message);
          continue;
        }
        rows.push(...((data || []) as RelationRow[]));
      }
      return rows;
    }

    function renderCard(item: Recommendation, index: number): HTMLElement {
      const accents = ["orange", "violet", "cyan", "mint", "rose", "blue"];
      const card = makeElement("article", `recommend-card accent-${accents[index % accents.length]}`);
      const top = makeElement("div", "recommend-card-top");
      const symbol = item.kind === "shortcut" ? "/" : item.kind === "image" ? "✳" : item.kind === "video" ? "▶" : "✦";
      top.append(
        makeElement("span", "recommend-symbol", symbol),
        makeElement("span", "recommend-index", String(index + 1).padStart(2, "0")),
      );
      card.append(top);

      const meta = makeElement("div", "recommend-meta");
      meta.append(
        makeElement("span", "recommend-category", item.category || (item.kind === "shortcut" ? "Quick command" : "Creative prompt")),
        makeElement("span", "recommend-kind", item.kind === "shortcut" ? "Shortcut" : `${item.kind} prompt`),
      );
      card.append(meta);

      if (item.thumbnailUrl && item.kind !== "shortcut") {
        const image = makeElement("img", "recommend-thumbnail") as HTMLImageElement;
        image.src = item.thumbnailUrl;
        image.alt = `${item.title} preview`;
        image.loading = "lazy";
        image.decoding = "async";
        image.addEventListener("error", () => image.remove(), { once: true });
        card.append(image);
      }

      card.append(
        makeElement("h3", "recommend-title", item.title),
        makeElement("p", "recommend-description", item.description || "Open this item to explore its details."),
      );

      if (item.tags.length) {
        const tagRow = makeElement("div", "recommend-tags");
        item.tags.slice(0, 4).forEach((tag) => tagRow.append(makeElement("span", "", `#${tag}`)));
        card.append(tagRow);
      }

      const link = makeElement("a", "recommend-link") as HTMLAnchorElement;
      link.href = item.href;
      link.append(
        makeElement("span", "", item.kind === "shortcut" ? "Explore shortcuts" : "Explore prompts"),
        makeElement("span", "recommend-arrow", "↗"),
      );
      card.append(link);
      return card;
    }

    function renderRandomPicks(): void {
      if (!grid) return;
      const picks = shuffle(allRecommendations).slice(0, PICK_COUNT);
      grid.replaceChildren();

      if (!picks.length) {
        grid.append(makeElement("p", "feed-message", "No published prompts or shortcuts are available yet."));
        if (summary) summary.textContent = "Your discovery feed is waiting for published content.";
        return;
      }

      const fragment = document.createDocumentFragment();
      picks.forEach((item, index) => fragment.append(renderCard(item, index)));
      grid.append(fragment);

      if (summary) {
        summary.textContent = `Showing ${picks.length} random picks from ${allRecommendations.length.toLocaleString()} published prompts and shortcuts.`;
      }
    }

    async function loadRecommendations(): Promise<void> {
      if (!grid) return;
      grid.replaceChildren(makeElement("p", "feed-message", "Loading recommendations…"));
      errorBox?.classList.add("hidden");
      if (shuffleButton) shuffleButton.disabled = true;

      try {
        const prompts: PromptRow[] = [];
        const shortcuts: ShortcutRow[] = [];
        const pageSize = 1000;

        // Supabase may cap a response at 1,000 rows, so page through the full
        // published library before choosing the random recommendations.
        for (let offset = 0; ; offset += pageSize) {
          const { data, error } = await supabase
            .from("prompts")
            .select("id,title,description,prompt_type")
            .eq("status", "published")
            .range(offset, offset + pageSize - 1);
          if (error) throw new Error(`Prompts: ${error.message}`);
          const page = (data || []) as PromptRow[];
          prompts.push(...page);
          if (page.length < pageSize) break;
        }

        for (let offset = 0; ; offset += pageSize) {
          const { data, error } = await supabase
            .from("shortcuts")
            .select("id,name,description")
            .eq("status", "published")
            .range(offset, offset + pageSize - 1);
          if (error) throw new Error(`Shortcuts: ${error.message}`);
          const page = (data || []) as ShortcutRow[];
          shortcuts.push(...page);
          if (page.length < pageSize) break;
        }
        const promptIds = prompts.map((row) => row.id);
        const shortcutIds = shortcuts.map((row) => row.id);

        const [promptCategories, promptTags, shortcutCategories, shortcutTags] = await Promise.all([
          fetchRelations("prompt_categories", "prompt_id", promptIds, "category_id"),
          fetchRelations("prompt_tags", "prompt_id", promptIds, "tag_id"),
          fetchRelations("shortcut_categories", "shortcut_id", shortcutIds, "category_id"),
          fetchRelations("shortcut_tags", "shortcut_id", shortcutIds, "tag_id"),
        ]);

        const categoryIds = [...new Set(
          [...promptCategories, ...shortcutCategories]
            .map((row) => row.category_id)
            .filter((id): id is string => Boolean(id)),
        )];
        const tagIds = [...new Set(
          [...promptTags, ...shortcutTags]
            .map((row) => row.tag_id)
            .filter((id): id is string => Boolean(id)),
        )];

        const [categoryResult, tagResult] = await Promise.all([
          categoryIds.length
            ? supabase.from("categories").select("id,name").in("id", categoryIds)
            : Promise.resolve({ data: [], error: null }),
          tagIds.length
            ? supabase.from("tags").select("id,name").in("id", tagIds)
            : Promise.resolve({ data: [], error: null }),
        ]);

        if (categoryResult.error) console.warn("Category names unavailable:", categoryResult.error.message);
        if (tagResult.error) console.warn("Tag names unavailable:", tagResult.error.message);

        const categoryNames = new Map(
          ((categoryResult.data || []) as { id: string; name: string }[]).map((row) => [row.id, row.name]),
        );
        const tagNames = new Map(
          ((tagResult.data || []) as { id: string; name: string }[]).map((row) => [row.id, row.name]),
        );

        // Thumbnail support is optional; a missing column or file must not block recommendations.
        const thumbnailMap = new Map<string, string>();
        for (let offset = 0; offset < promptIds.length; offset += 150) {
          const thumbResult = await supabase
            .from("prompts")
            .select("id,thumbnail_path")
            .in("id", promptIds.slice(offset, offset + 150));
          if (thumbResult.error) {
            console.info("Prompt thumbnails are unavailable:", thumbResult.error.message);
            break;
          }
          for (const row of (thumbResult.data || []) as { id: string; thumbnail_path: string | null }[]) {
            if (row.thumbnail_path) {
              const url = supabase.storage.from("prompt-thumbnails").getPublicUrl(row.thumbnail_path).data?.publicUrl;
              if (url) thumbnailMap.set(row.id, url);
            }
          }
        }

        const promptItems: Recommendation[] = prompts.map((row) => {
          const promptType = String(row.prompt_type || "other").toLowerCase();
          const kind: Recommendation["kind"] =
            promptType === "image" || promptType === "video" ? promptType : "other";

          return {
            id: row.id,
            title: row.title,
            description: row.description || "",
            kind,
            category: promptCategories
              .filter((rel) => rel.prompt_id === row.id)
              .map((rel) => rel.category_id ? categoryNames.get(rel.category_id) : undefined)
              .find((name): name is string => Boolean(name)) || "",
            tags: promptTags
              .filter((rel) => rel.prompt_id === row.id)
              .map((rel) => rel.tag_id ? tagNames.get(rel.tag_id) : undefined)
              .filter((name): name is string => Boolean(name)),
            thumbnailUrl: thumbnailMap.get(row.id) || null,
            href: "/prompts",
          };
        });

        const shortcutItems: Recommendation[] = shortcuts.map((row) => ({
          id: row.id,
          title: row.name,
          description: row.description || "",
          kind: "shortcut",
          category: shortcutCategories
            .filter((rel) => rel.shortcut_id === row.id)
            .map((rel) => rel.category_id ? categoryNames.get(rel.category_id) : undefined)
            .find((name): name is string => Boolean(name)) || "",
          tags: shortcutTags
            .filter((rel) => rel.shortcut_id === row.id)
            .map((rel) => rel.tag_id ? tagNames.get(rel.tag_id) : undefined)
            .filter((name): name is string => Boolean(name)),
          thumbnailUrl: null,
          href: "/shortcuts",
        }));

        allRecommendations = [...promptItems, ...shortcutItems];
        renderRandomPicks();
      } catch (error) {
        console.error("Recommendation feed failed:", error);
        grid.replaceChildren(makeElement("p", "feed-message", "Recommendations could not be loaded."));
        if (summary) summary.textContent = "Please try again in a moment.";
        if (errorBox) {
          errorBox.textContent = error instanceof Error ? error.message : "Unknown loading error.";
          errorBox.classList.remove("hidden");
        }
      } finally {
        if (shuffleButton) shuffleButton.disabled = false;
      }
    }

    shuffleButton?.addEventListener("click", renderRandomPicks);
    loadRecommendations();
  </script>
</MainLayout>

<style is:global>
  .explore-page {
    min-height: 100vh;
    padding: 0 0 100px;
    color: #f4f2f7;
    background:
      radial-gradient(ellipse at 8% 12%, rgba(8, 145, 178, .07), transparent 34%),
      radial-gradient(ellipse at 92% 18%, rgba(249, 115, 22, .07), transparent 32%);
  }

  .recommend-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(62px, 8vw, 104px) 24px 58px;
    text-align: center;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background:
      radial-gradient(ellipse at 20% 0%, rgba(124,58,237,.17), transparent 42%),
      radial-gradient(ellipse at 82% 5%, rgba(249,115,22,.14), transparent 40%),
      linear-gradient(180deg, rgba(14,16,25,.72), rgba(8,9,14,.96));
  }

  .recommend-hero::before {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
    opacity: .34;
    background-image: radial-gradient(rgba(255,255,255,.2) .7px, transparent .8px);
    background-size: 19px 19px;
    mask-image: linear-gradient(to bottom, black, transparent 95%);
  }

  .eyebrow, .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #83e8f2;
    font: 700 10px/1.4 "JetBrains Mono", monospace;
    letter-spacing: .16em;
  }

  .eyebrow {
    position: relative;
    padding: 9px 14px;
    border: 1px solid rgba(103,232,249,.24);
    border-radius: 999px;
    background: rgba(34,211,238,.06);
  }

  .eyebrow i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #67e8f9;
    box-shadow: 0 0 12px #67e8f9;
  }

  .recommend-hero h1 {
    position: relative;
    margin: 25px 0 13px;
    color: #f6f4f8;
    font: 650 clamp(42px, 6vw, 72px)/1.06 "Space Grotesk", sans-serif;
    letter-spacing: -.065em;
  }

  .recommend-hero h1 span {
    color: transparent;
    background: linear-gradient(100deg, #78e6d0, #8ca7ff 48%, #ffad77);
    background-clip: text;
    -webkit-background-clip: text;
  }

  .recommend-hero p {
    position: relative;
    margin: 0;
    color: #a3a3b1;
    font-size: 14px;
  }

  .recommend-section {
    width: min(100% - 64px, 1450px);
    margin: 0 auto;
    padding-top: 48px;
  }

  .recommend-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 26px;
  }

  .section-kicker {
    color: #ffad77;
    font-size: 9px;
  }

  .recommend-heading h2 {
    margin: 9px 0 7px;
    color: #f3f1f6;
    font: 650 clamp(27px, 3vw, 38px)/1.15 "Space Grotesk", sans-serif;
    letter-spacing: -.045em;
  }

  .recommend-heading h2 span { color: #ff9b52; }

  .recommend-heading p {
    margin: 0;
    color: #9293a1;
    font-size: 13px;
  }

  .shuffle-button {
    display: inline-flex;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 17px;
    border: 1px solid rgba(103,232,249,.28);
    border-radius: 12px;
    background: linear-gradient(120deg, rgba(8,145,178,.18), rgba(124,58,237,.15), rgba(249,115,22,.13));
    color: #dffaff;
    font: 600 12px "Inter", sans-serif;
    cursor: pointer;
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }

  .shuffle-button span { font-size: 20px; line-height: 1; }
  .shuffle-button:hover:not(:disabled) {
    transform: translateY(-2px);
    border-color: rgba(103,232,249,.58);
    box-shadow: 0 8px 28px rgba(34,211,238,.1);
  }
  .shuffle-button:disabled { opacity: .55; cursor: wait; }

  .recommend-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .recommend-card {
    --accent: #7dd3fc;
    display: flex;
    min-width: 0;
    min-height: 310px;
    flex-direction: column;
    padding: 25px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 22px;
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 44%),
      linear-gradient(145deg, rgba(25,26,34,.97), rgba(15,16,22,.98));
    box-shadow: 0 14px 38px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.035);
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  }

  .recommend-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 42%, rgba(255,255,255,.12));
    box-shadow: 0 20px 46px rgba(0,0,0,.28);
  }

  .accent-orange { --accent: #ffad70; }
  .accent-violet { --accent: #a5a7ff; }
  .accent-cyan { --accent: #62e5ed; }
  .accent-mint { --accent: #75e5b4; }
  .accent-rose { --accent: #f49ac2; }
  .accent-blue { --accent: #80b8ff; }

  .recommend-card-top, .recommend-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .recommend-symbol {
    display: grid;
    width: 43px;
    height: 43px;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 13px;
    background: color-mix(in srgb, var(--accent) 11%, transparent);
    color: var(--accent);
    font-size: 23px;
  }

  .recommend-index {
    color: #686a78;
    font: 10px "JetBrains Mono", monospace;
  }

  .recommend-meta {
    justify-content: flex-start;
    flex-wrap: wrap;
    margin: 23px 0 15px;
  }

  .recommend-category {
    overflow: hidden;
    max-width: 72%;
    color: var(--accent);
    font: 600 10px "JetBrains Mono", monospace;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .recommend-kind {
    padding-left: 11px;
    border-left: 1px solid rgba(255,255,255,.16);
    color: #8d8e9a;
    font: 10px "JetBrains Mono", monospace;
    text-transform: capitalize;
  }

  .recommend-thumbnail {
    width: 100%;
    max-height: 180px;
    margin: 0 0 17px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 12px;
    object-fit: cover;
  }

  .recommend-title {
    margin: 0;
    color: var(--accent);
    font: 650 clamp(21px, 2vw, 27px)/1.2 "Space Grotesk", sans-serif;
    letter-spacing: -.04em;
    overflow-wrap: anywhere;
  }

  .recommend-description {
    margin: 12px 0 18px;
    color: #a5a5b1;
    font-size: 14px;
    line-height: 1.65;
  }

  .recommend-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0 0 18px;
  }

  .recommend-tags span {
    padding: 5px 8px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 7px;
    color: #9b9ca9;
    font-size: 10px;
  }

  .recommend-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 17px;
    border-top: 1px solid rgba(255,255,255,.09);
    color: var(--accent);
    font-size: 12px;
    font-weight: 650;
    text-decoration: none;
  }

  .recommend-arrow { font-size: 17px; transition: transform .2s ease; }
  .recommend-link:hover .recommend-arrow { transform: translate(3px, -2px); }

  .feed-message, .feed-error {
    grid-column: 1 / -1;
    margin: 0;
    padding: 24px;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 14px;
    background: rgba(20,21,29,.75);
    color: #a6a7b2;
    font-size: 14px;
  }

  .feed-error { margin-top: 14px; border-color: rgba(248,113,113,.25); color: #fca5a5; }
  .hidden { display: none !important; }

  @media (max-width: 1050px) {
    .recommend-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 650px) {
    .recommend-section { width: min(100% - 32px, 100%); padding-top: 34px; }
    .recommend-hero { padding: 58px 18px 44px; }
    .recommend-heading { align-items: flex-start; flex-direction: column; }
    .recommend-grid { grid-template-columns: 1fr; gap: 15px; }
    .recommend-card { min-height: 280px; padding: 21px; }
    .shuffle-button { width: 100%; }
  }
</style>
