---
import MainLayout from "../layouts/MainLayout.astro";

const pageTitle = "PromptVault — Find inspiration. Create without limits.";
const pageDescription = "Discover curated AI image prompts, cinematic video prompts and creative shortcuts in one modern library.";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <div class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
      <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
      <div class="hero-glow glow-violet" aria-hidden="true"></div>
      <div class="hero-glow glow-coral" aria-hidden="true"></div>
      <div class="hero-content">
        <div class="hero-badge"><span class="badge-dot"></span> THE CREATIVE PROMPT LIBRARY</div>
        <h1 id="hero-title">Find your next <span class="hero-gradient">great idea.</span><span class="hero-subtitle">Create without limits.</span></h1>
        <p class="hero-description">A curated space for striking AI images, cinematic video, and useful creative shortcuts. Find a starting point, then make it yours.</p>
        <form action="/explore" method="get" class="search-box" role="search">
          <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 4 4"></path></svg>
          <input name="q" type="search" autocomplete="off" placeholder="Search prompts, styles, shortcuts..." aria-label="Search the PromptVault library" />
          <button type="submit">Explore <span aria-hidden="true">↗</span></button>
        </form>
        <nav class="popular-searches" aria-label="Popular searches">
          <span>TRY</span>
          <a href="/explore?q=4K">4K detail</a>
          <a href="/explore?q=cinematic">cinematic</a>
          <a href="/explore?q=portrait">portrait</a>
          <a href="/explore?q=neon">neon</a>
        </nav>
      </div>
      <div class="hero-footer" aria-hidden="true"><span>01 — DISCOVER</span><span>YOUR CREATIVE WORKSPACE</span></div>
    </section>

    <section class="library-section" aria-labelledby="library-title">
      <div class="section-heading">
        <div>
          <span class="section-eyebrow">START EXPLORING</span>
          <h2 id="library-title">A library built for <span>making.</span></h2>
          <p class="section-description">Jump straight into the tools and inspiration you need.</p>
        </div>
        <a href="/explore" class="view-all">Browse everything <span aria-hidden="true">↗</span></a>
      </div>

      <div class="category-grid">
        <a href="/shortcuts" class="category-card card-violet">
          <div class="card-top"><span class="category-icon" aria-hidden="true">⌁</span><span class="card-index">01</span></div>
          <div class="card-content"><span class="card-label">QUICK COMMANDS</span><h3>Shortcuts</h3><p>Small commands. Big creative impact. <span aria-hidden="true">↗</span></p></div>
          <span class="card-watermark" aria-hidden="true">/</span>
        </a>
        <a href="/prompts" class="category-card card-cyan">
          <div class="card-top"><span class="category-icon" aria-hidden="true">✳</span><span class="card-index">02</span></div>
          <div class="card-content"><span class="card-label">VISUAL CREATION</span><h3>Image prompts</h3><p>Build detailed visual worlds. <span aria-hidden="true">↗</span></p></div>
          <span class="card-watermark" aria-hidden="true">✳</span>
        </a>
        <a href="/prompts" class="category-card card-rose">
          <div class="card-top"><span class="category-icon" aria-hidden="true">▶</span><span class="card-index">03</span></div>
          <div class="card-content"><span class="card-label">MOTION & STORY</span><h3>Video prompts</h3><p>Shape scenes in motion. <span aria-hidden="true">↗</span></p></div>
          <span class="card-watermark" aria-hidden="true">▶</span>
        </a>
        <a href="/explore" class="category-card card-amber">
          <div class="card-top"><span class="category-icon" aria-hidden="true">✣</span><span class="card-index">04</span></div>
          <div class="card-content"><span class="card-label">THE FULL COLLECTION</span><h3>Explore all</h3><p>Find your next starting point. <span aria-hidden="true">↗</span></p></div>
          <span class="card-watermark" aria-hidden="true">✣</span>
        </a>
      </div>
      <div class="bottom-note"><span class="note-line"></span><span>GOOD IDEAS ARE BUILT, NOT FOUND.</span><span class="note-line"></span></div>
    </section>
  </div>
</MainLayout>

<style>
  .home-page{width:100%;overflow:hidden;color:#f5f3f8}
  .hero{position:relative;isolation:isolate;min-height:600px;display:grid;place-items:center;padding:88px 24px 106px;overflow:hidden;border-bottom:1px solid rgba(255,255,255,.08);background:radial-gradient(ellipse at 50% 16%,rgba(126,87,194,.20),transparent 44%),radial-gradient(ellipse at 88% 45%,rgba(244,104,82,.10),transparent 34%),linear-gradient(180deg,rgba(10,10,15,.22),rgba(8,9,13,.9))}
  .hero::before{position:absolute;z-index:-2;inset:0;content:"";background:linear-gradient(90deg,transparent 0 12%,rgba(255,255,255,.035) 12.15%,transparent 12.7% 25%,rgba(255,112,83,.09) 25.2%,transparent 26% 74%,rgba(112,190,255,.055) 74.2%,transparent 75% 88%,rgba(255,255,255,.035) 88.2%,transparent 89%);opacity:.8}
  .hero::after{position:absolute;z-index:-2;inset:0;content:"";background-image:radial-gradient(rgba(255,255,255,.19) .7px,transparent .9px);background-size:22px 22px;opacity:.12;mask-image:linear-gradient(to bottom,#000,transparent 88%)}
  .hero-content{width:min(100%,900px);margin:auto;text-align:center}
  .hero-glow{position:absolute;z-index:-1;width:390px;height:390px;border-radius:50%;filter:blur(115px);pointer-events:none}
  .glow-violet{top:5%;left:20%;background:rgba(139,92,246,.17)}.glow-coral{top:12%;right:12%;background:rgba(251,113,133,.13)}
  .hero-orbit{position:absolute;z-index:-1;left:50%;width:min(90vw,1100px);height:450px;border:1px solid rgba(255,255,255,.035);border-radius:50%;transform:translateX(-50%);pointer-events:none}.hero-orbit-one{top:-335px}.hero-orbit-two{top:-290px;width:min(75vw,900px);border-color:rgba(167,139,250,.055)}
  .hero-badge{display:inline-flex;align-items:center;gap:10px;padding:9px 15px;border:1px solid rgba(167,139,250,.28);border-radius:999px;background:rgba(139,92,246,.10);color:#d8caff;font:600 10px "JetBrains Mono",monospace;letter-spacing:.12em}
  .badge-dot{width:7px;height:7px;border-radius:50%;background:#b69aff;box-shadow:0 0 13px #a78bfa}
  .hero h1{margin:30px auto 0;color:#f7f5fa;font-family:"Space Grotesk",sans-serif;font-size:clamp(46px,7vw,86px);font-weight:700;line-height:1.04;letter-spacing:-.075em}
  .hero-gradient{display:block;background:linear-gradient(100deg,#b69aff 5%,#8eb5ff 52%,#ff9b9b 100%);background-clip:text;-webkit-background-clip:text;color:transparent}
  .hero-subtitle{display:block;margin-top:7px;color:#f4f0fa;font-size:.69em;letter-spacing:-.06em}
  .hero-description{max-width:640px;margin:25px auto 0;color:#aaa9b7;font-size:16px;line-height:1.85}
  .search-box{display:flex;align-items:center;gap:13px;width:min(100%,650px);min-height:68px;margin:36px auto 0;padding:9px 10px 9px 20px;border:1px solid rgba(255,255,255,.13);border-radius:17px;background:linear-gradient(130deg,rgba(31,31,41,.94),rgba(17,18,25,.96));box-shadow:0 20px 65px rgba(0,0,0,.32),inset 0 1px 0 rgba(255,255,255,.06);backdrop-filter:blur(20px);transition:border-color .2s,box-shadow .2s}
  .search-box:focus-within{border-color:rgba(103,232,249,.5);box-shadow:0 0 0 3px rgba(103,232,249,.08),0 20px 65px rgba(0,0,0,.35)}
  .search-icon{width:19px;height:19px;flex:none;fill:none;stroke:#67d9ed;stroke-width:1.8;stroke-linecap:round}
  .search-box input{width:100%;min-width:0;height:45px;padding:0;border:0;outline:0;background:transparent;color:#f5f3f8;font:400 14px "DM Sans",sans-serif;box-shadow:none}
  .search-box input:focus{border:0;outline:0;box-shadow:none}.search-box input::placeholder{color:#858593}
  .search-box button{flex:none;min-width:105px;height:45px;padding:0 17px;border:1px solid rgba(255,255,255,.16);border-radius:11px;background:linear-gradient(115deg,#b69aff,#8eb5ff);color:#171321;font-size:13px;font-weight:700;cursor:pointer;transition:transform .2s,box-shadow .2s}
  .search-box button:hover{transform:translateY(-2px);box-shadow:0 9px 24px rgba(142,181,255,.24)}.search-box button span{margin-left:7px}
  .popular-searches{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:19px;margin-top:20px;color:#858492;font:10px "JetBrains Mono",monospace}.popular-searches>span{color:#6f6e7c;letter-spacing:.12em}.popular-searches a{color:#aaa8b5;transition:color .2s}.popular-searches a:hover{color:#83e8f2}
  .hero-footer{position:absolute;right:6%;bottom:22px;left:6%;display:flex;justify-content:space-between;color:#666775;font:9px "JetBrains Mono",monospace;letter-spacing:.13em}
  .library-section{width:min(calc(100% - 48px),1250px);margin:0 auto;padding:66px 0 80px}
  .section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:28px}.section-eyebrow{color:#67e8f9;font:600 10px "JetBrains Mono",monospace;letter-spacing:.17em}
  .section-heading h2{margin:10px 0 0;color:#f4f1f8;font:700 clamp(27px,3vw,38px)/1.15 "Space Grotesk",sans-serif;letter-spacing:-.055em}.section-heading h2 span{background:linear-gradient(90deg,#b69aff,#ff9b9b);background-clip:text;-webkit-background-clip:text;color:transparent}.section-description{margin:9px 0 0;color:#92919e;font-size:13px}
  .view-all{display:inline-flex;align-items:center;gap:11px;padding:11px 15px;border:1px solid rgba(255,255,255,.13);border-radius:11px;background:rgba(255,255,255,.035);color:#c4c1ce;font-size:11px;white-space:nowrap;transition:.2s}.view-all:hover{border-color:rgba(103,232,249,.42);background:rgba(34,211,238,.07);color:#67e8f9}.view-all span{font-size:15px}
  .category-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .category-card{--accent:#b69aff;--accent-rgb:182,154,255;position:relative;isolation:isolate;min-height:220px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;padding:22px;border:1px solid rgba(255,255,255,.10);border-radius:19px;background:linear-gradient(145deg,rgba(29,29,39,.96),rgba(16,17,24,.98) 78%);box-shadow:0 14px 35px rgba(0,0,0,.20),inset 0 1px 0 rgba(255,255,255,.04);transition:transform .25s,border-color .25s,box-shadow .25s}
  .card-violet{--accent:#c4a7ff;--accent-rgb:196,167,255}.card-cyan{--accent:#67e8f9;--accent-rgb:103,232,249}.card-rose{--accent:#fb91b5;--accent-rgb:251,145,181}.card-amber{--accent:#ffbd76;--accent-rgb:255,189,118}
  .category-card::before{position:absolute;z-index:-1;inset:0;content:"";background:radial-gradient(circle at 100% 100%,rgba(var(--accent-rgb),.12),transparent 52%);opacity:.75;transition:opacity .25s}
  .category-card:hover{transform:translateY(-6px);border-color:rgba(var(--accent-rgb),.45);box-shadow:0 24px 48px rgba(0,0,0,.34),0 0 30px rgba(var(--accent-rgb),.08)}.category-card:hover::before{opacity:1}
  .card-top{display:flex;align-items:center;justify-content:space-between}.category-icon{width:47px;height:47px;display:grid;place-items:center;border:1px solid rgba(var(--accent-rgb),.25);border-radius:14px;background:rgba(var(--accent-rgb),.12);color:var(--accent);font:600 24px "Space Grotesk",sans-serif}.card-index{color:#737381;font:10px "JetBrains Mono",monospace}
  .card-content{position:relative;z-index:1;margin-top:30px}.card-label{color:var(--accent);font:600 9px "JetBrains Mono",monospace;letter-spacing:.13em}.card-content h3{margin:8px 0 0;color:#f4f2f8;font:600 21px "Space Grotesk",sans-serif;letter-spacing:-.04em}.card-content p{display:flex;align-items:center;gap:8px;margin:12px 0 0;color:#aaa8b5;font-size:12px;transition:color .2s}.card-content p span{color:var(--accent);transition:transform .2s}.category-card:hover .card-content p{color:#e3e0e9}.category-card:hover .card-content p span{transform:translate(3px,-3px)}
  .card-watermark{position:absolute;right:12px;bottom:-42px;z-index:-1;color:rgba(var(--accent-rgb),.055);font:700 150px/.9 "Space Grotesk",sans-serif;pointer-events:none}
  .bottom-note{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:38px;color:#656573;font:9px "JetBrains Mono",monospace;letter-spacing:.16em}.note-line{width:48px;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.18))}.note-line:last-child{transform:rotate(180deg)}
  @media(min-width:1400px){.hero{min-height:660px}}
  @media(max-width:900px){.category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero{min-height:570px}}
  @media(max-width:600px){.hero{min-height:570px;padding:72px 19px 92px}.hero h1{margin-top:27px;font-size:clamp(43px,11vw,62px)}.hero-description{margin-top:20px;font-size:14px}.search-box{gap:9px;margin-top:28px;padding:7px 8px 7px 13px}.search-box button{min-width:82px;padding:0 11px;font-size:12px}.search-box input{font-size:12px}.popular-searches{gap:12px;font-size:9px}.hero-footer{right:19px;left:19px;font-size:8px}.library-section{width:calc(100% - 36px);padding:48px 0 65px}.section-heading{align-items:flex-start}.view-all{padding:9px 10px;font-size:10px}.category-grid{gap:11px}.category-card{min-height:190px;padding:16px}.category-icon{width:41px;height:41px}.card-content h3{font-size:17px}.card-content p{font-size:11px}.card-watermark{font-size:120px}.bottom-note{font-size:8px;gap:10px}}
  @media(max-width:380px){.category-grid{grid-template-columns:1fr}.category-card{min-height:165px}.section-heading{flex-direction:column}.view-all{align-self:flex-start}}
  @media(prefers-reduced-motion:reduce){.category-card,.view-all,.search-box,.search-box button,.category-card::before{transition:none}}
</style>
