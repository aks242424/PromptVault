---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Prompts Library — PromptVault"
  description="Explore published AI image and video generation prompts."
>
  <main class="prompts-page">
    <section class="prompts-hero">
      <div class="hero-light hero-light-blue"></div>
      <div class="hero-light hero-light-rose"></div>
      <div class="hero-inner">
        <span class="eyebrow"><i></i> THE VISUAL PROMPT LIBRARY</span>
        <h1>Prompts <span>that create.</span></h1>
        <p id="hero-subtitle" class="hero-subtitle">Loading published prompts...</p>
        <label class="search-field">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <input id="prompt-search" type="search" placeholder="Search prompts, styles, categories..." aria-label="Search prompts" />
          <kbd>SEARCH</kbd>
        </label>
      </div>
      <div class="hero-rule"></div>
    </section>

    <section class="prompt-collection">
      <div class="toolbar">
        <div id="prompt-types" class="filter-list type-filters" aria-label="Filter prompt type">
          <button data-type="all" class="type-button active" aria-pressed="true">All prompts <span id="all-prompt-total">0</span></button>
          <button data-type="image" class="type-button type-image" aria-pressed="false">Image prompts</button>
          <button data-type="video" class="type-button type-video" aria-pressed="false">Video prompts</button>
          <button data-type="other" class="type-button type-other" aria-pressed="false">Other prompts</button>
        </div>
        <div class="category-filter-block">
          <span class="filter-label">CATEGORIES</span>
          <div id="prompt-categories" class="filter-list category-filters" aria-label="Filter prompts by category">
            <button data-category="all" class="category-button active" aria-pressed="true">All categories</button>
          </div>
        </div>
      </div>

      <div class="results-heading">
        <div>
          <span class="results-kicker">PROMPT LIBRARY</span>
          <h2>Creative prompts<span>.</span></h2>
        </div>
        <p><strong id="prompt-count">0</strong> results</p>
      </div>

      <div id="prompt-grid" class="prompt-grid" aria-live="polite">
        <p class="load-state">Loading published prompts...</p>
      </div>

      <div id="prompt-empty" class="empty-state hidden">
        <div class="empty-symbol">⌕</div>
        <h3 id="empty-title">No matching prompts</h3>
        <button id="reset-filters" type="button">Clear filters <span>↗</span></button>
      </div>
      <p id="prompt-error" class="load-error hidden" role="alert"></p>
    </section>
  </main>

  <script>
    import { supabase } from "../lib/supabase.js";

    const search = document.querySelector<HTMLInputElement>("#prompt-search");
    const categoryContainer = document.querySelector<HTMLElement>("#prompt-categories");
    const grid = document.querySelector<HTMLElement>("#prompt-grid");
    const count = document.querySelector<HTMLElement>("#prompt-count");
    const allTotal = document.querySelector<HTMLElement>("#all-prompt-total");
    const heroSubtitle = document.querySelector<HTMLElement>("#hero-subtitle");
    const empty = document.querySelector<HTMLElement>("#prompt-empty");
    const emptyTitle = document.querySelector<HTMLElement>("#empty-title");
    const errorMessage = document.querySelector<HTMLElement>("#prompt-error");
    const resetButton = document.querySelector<HTMLButtonElement>("#reset-filters");
    const typeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".type-button"));

    let prompts: any[] = [];
    let activeType = "all";
    let activeCategory = "all";

    function element<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className?: string,
      text?: string
    ): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function renderCard(prompt: any, index: number) {
      const promptType = String(prompt.prompt_type || "other").toLowerCase();
      const isVideo = promptType === "video";
      const isImage = promptType === "image";
      const card = element("article", `prompt-card ${isVideo ? "prompt-video" : isImage ? "prompt-image" : "prompt-other"}`);
      const categories = Array.isArray(prompt.categories) ? prompt.categories : [];
      const tags = Array.isArray(prompt.tags) ? prompt.tags : [];
      const content = String(prompt.content || "");
      const title = String(prompt.title || "Untitled prompt");
      const description = String(prompt.description || "");
      const searchable = [title, description, content, categories.join(" "), tags.join(" "), (prompt.ai_tools || []).join(" ")]
        .filter(Boolean).join(" ").toLowerCase();

      card.id = `prompt-${prompt.id}`;
      card.dataset.id = String(prompt.id);
      card.dataset.type = promptType;
      card.dataset.categories = JSON.stringify(categories);
      card.dataset.search = searchable;

      const top = element("div", "card-topline");
      const mark = element("span", "type-mark", isVideo ? "▶" : isImage ? "✳" : "✦");
      mark.setAttribute("aria-label", `${promptType} prompt`);
      const topActions = element("div", "card-top-actions");
      topActions.append(element("span", "card-number", String(index + 1).padStart(2, "0")));
      const favourite = element("button", "utility-favourite", "☆") as HTMLButtonElement;
      favourite.type = "button";
      favourite.dataset.utilityFavourite = "true";
      favourite.dataset.itemType = "prompt";
      favourite.dataset.itemId = String(prompt.id);
      favourite.dataset.itemTitle = title;
      favourite.setAttribute("aria-label", `Add ${title} to favourites`);
      favourite.setAttribute("aria-pressed", "false");
      favourite.addEventListener("click", () => {
        const key = "promptvault:favourites";
        let saved: any[] = [];
        try {
          const parsed = JSON.parse(localStorage.getItem(key) || "[]");
          saved = Array.isArray(parsed) ? parsed : [];
        } catch {}
        const exists = saved.some((item) => item.type === "prompt" && String(item.id) === String(prompt.id));
        saved = exists
          ? saved.filter((item) => !(item.type === "prompt" && String(item.id) === String(prompt.id)))
          : [...saved, { type: "prompt", id: String(prompt.id), title, url: "/prompts" }];
        localStorage.setItem(key, JSON.stringify(saved));
        favourite.textContent = exists ? "☆" : "★";
        favourite.classList.toggle("is-favourite", !exists);
        favourite.setAttribute("aria-pressed", String(!exists));
        favourite.setAttribute("aria-label", `${exists ? "Add" : "Remove"} ${title} ${exists ? "to" : "from"} favourites`);
        window.dispatchEvent(new CustomEvent("promptvault:favourites-updated"));
      });
      topActions.append(favourite);
      top.append(mark, topActions);
      card.append(top);

      try {
        const saved = JSON.parse(localStorage.getItem("promptvault:favourites") || "[]");
        const active = Array.isArray(saved) && saved.some((item) => item.type === "prompt" && String(item.id) === String(prompt.id));
        favourite.textContent = active ? "★" : "☆";
        favourite.classList.toggle("is-favourite", active);
        favourite.setAttribute("aria-pressed", String(active));
      } catch {}

      if (prompt.thumbnail_path) {
        const { data } = supabase.storage.from("prompt-thumbnails").getPublicUrl(prompt.thumbnail_path);
        if (data?.publicUrl) {
          const image = element("img", "prompt-thumbnail") as HTMLImageElement;
          image.src = data.publicUrl;
          image.alt = title;
          image.loading = "lazy";
          image.addEventListener("error", () => image.remove(), { once: true });
          card.append(image);
        }
      }

      const meta = element("div", "card-meta");
      meta.append(element("span", "category-name", categories.join(" · ") || "Uncategorized"));
      meta.append(element("span", "type-name", promptType.toUpperCase()));
      card.append(meta);
      card.append(element("h3", "", title));
      card.append(element("p", "card-description", description));

      if (tags.length) {
        const tagList = element("div", "tag-list");
        tags.slice(0, 4).forEach((tag: string) => tagList.append(element("span", "", `#${tag}`)));
        card.append(tagList);
      }

      const footer = element("div", "card-footer");
      const ready = element("span", "ready-label", "READY TO USE");
      const copy = element("button", "copy-prompt") as HTMLButtonElement;
      copy.type = "button";
      copy.disabled = !content.trim();
      copy.append(element("span", "copy-icon", "▢"), document.createTextNode(" Copy prompt"));
      copy.addEventListener("click", async () => {
        if (!content.trim()) return;
        try {
          await navigator.clipboard.writeText(content);
          copy.replaceChildren(element("span", "copy-icon", "✓"), document.createTextNode(" Copied"));
          copy.classList.add("copied");
          window.setTimeout(() => {
            copy.replaceChildren(element("span", "copy-icon", "▢"), document.createTextNode(" Copy prompt"));
            copy.classList.remove("copied");
          }, 1600);
        } catch {
          copy.replaceChildren(document.createTextNode("Copy unavailable"));
        }
      });
      footer.append(ready, copy);
      card.append(footer);

      card.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("button")) return;
        const key = "promptvault:recent";
        let recent: any[] = [];
        try {
          const parsed = JSON.parse(localStorage.getItem(key) || "[]");
          recent = Array.isArray(parsed) ? parsed : [];
        } catch {}
        recent = recent.filter((item) => !(item.type === "prompt" && String(item.id) === String(prompt.id)));
        recent.unshift({ type: "prompt", id: String(prompt.id), title, url: "/prompts" });
        localStorage.setItem(key, JSON.stringify(recent.slice(0, 20)));
        window.dispatchEvent(new CustomEvent("promptvault:recent-updated"));
      });
      return card;
    }

    function filterPrompts() {
      const query = search?.value.trim().toLowerCase() || "";
      const category = activeCategory;
      let visible = 0;

      Array.from(grid?.querySelectorAll<HTMLElement>(".prompt-card") || []).forEach((card) => {
        const show =
          (card.dataset.search || "").includes(query) &&
          (activeType === "all" || (card.dataset.type || "").toLowerCase() === activeType) &&
          (category === "all" || JSON.parse(card.dataset.categories || "[]").includes(category));
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      });

      if (count) count.textContent = String(visible);
      empty?.classList.toggle("hidden", visible !== 0);
      if (emptyTitle) emptyTitle.textContent = prompts.length ? "No matching prompts" : "No published prompts yet";
    }

    function updateButtons() {
      typeButtons.forEach((button) => {
        const active = button.dataset.type === activeType;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      categoryContainer?.querySelectorAll<HTMLButtonElement>(".category-button").forEach((button) => {
        const active = button.dataset.category === activeCategory;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    async function loadPrompts() {
      if (!grid) return;
      grid.replaceChildren(element("p", "load-state", "Loading published prompts..."));
      errorMessage?.classList.add("hidden");

      try {
        const { data: promptRows, error: promptError } = await supabase
          .from("prompts")
          .select("id, title, description, content, prompt_type, thumbnail_path, ai_tools, created_at")
          .eq("status", "published")
          .order("created_at", { ascending: false });

        if (promptError) throw promptError;

        const ids = (promptRows || []).map((prompt: any) => prompt.id);
        let categoryRows: any[] = [];
        let tagRows: any[] = [];

        if (ids.length) {
          const [categoryResult, tagResult] = await Promise.all([
            supabase.from("prompt_categories").select("prompt_id, category_id").in("prompt_id", ids),
            supabase.from("prompt_tags").select("prompt_id, tag_id").in("prompt_id", ids),
          ]);
          if (categoryResult.error) throw categoryResult.error;
          if (tagResult.error) throw tagResult.error;

          const categoryIds = [...new Set((categoryResult.data || []).map((row: any) => row.category_id))];
          const tagIds = [...new Set((tagResult.data || []).map((row: any) => row.tag_id))];

          const [categoriesResult, tagsResult] = await Promise.all([
            categoryIds.length
              ? supabase.from("categories").select("id, name").in("id", categoryIds)
              : Promise.resolve({ data: [], error: null }),
            tagIds.length
              ? supabase.from("tags").select("id, name").in("id", tagIds)
              : Promise.resolve({ data: [], error: null }),
          ]);

          if (categoriesResult.error) throw categoriesResult.error;
          if (tagsResult.error) throw tagsResult.error;

          const categoryNames = new Map((categoriesResult.data || []).map((row: any) => [row.id, row.name]));
          const tagNames = new Map((tagsResult.data || []).map((row: any) => [row.id, row.name]));

          categoryRows = categoryResult.data || [];
          tagRows = tagResult.data || [];

          prompts = (promptRows || []).map((prompt: any) => ({
            ...prompt,
            categories: categoryRows
              .filter((row) => row.prompt_id === prompt.id)
              .map((row) => categoryNames.get(row.category_id))
              .filter(Boolean),
            tags: tagRows
              .filter((row) => row.prompt_id === prompt.id)
              .map((row) => tagNames.get(row.tag_id))
              .filter(Boolean),
          }));
        } else {
          prompts = [];
        }

        const categories = [...new Set(prompts.flatMap((prompt) => prompt.categories))].sort((a, b) => a.localeCompare(b));
        if (categoryContainer) {
          categoryContainer.replaceChildren();
          const allButton = element("button", "category-button active", "All categories") as HTMLButtonElement;
          allButton.type = "button";
          allButton.dataset.category = "all";
          allButton.setAttribute("aria-pressed", "true");
          categoryContainer.append(allButton);
          categories.forEach((category) => {
            const button = element("button", "category-button", category) as HTMLButtonElement;
            button.type = "button";
            button.dataset.category = category;
            button.setAttribute("aria-pressed", "false");
            categoryContainer.append(button);
          });
        }

        if (allTotal) allTotal.textContent = String(prompts.length);
        if (heroSubtitle) heroSubtitle.textContent = `${prompts.length} published ${prompts.length === 1 ? "prompt" : "prompts"} in one collection.`;

        grid.replaceChildren();
        if (!prompts.length) {
          empty?.classList.remove("hidden");
          if (emptyTitle) emptyTitle.textContent = "No published prompts yet";
          if (resetButton) resetButton.classList.add("hidden");
          if (count) count.textContent = "0";
          return;
        }

        const fragment = document.createDocumentFragment();
        prompts.forEach((prompt, index) => fragment.append(renderCard(prompt, index)));
        grid.append(fragment);
        filterPrompts();
      } catch (error) {
        console.error("Prompt library load failed:", error);
        grid.replaceChildren();
        if (errorMessage) {
          errorMessage.textContent = "Unable to load published prompts right now. Please refresh the page and try again.";
          errorMessage.classList.remove("hidden");
        }
        if (heroSubtitle) heroSubtitle.textContent = "Published prompts are temporarily unavailable.";
        if (empty) empty.classList.add("hidden");
      }
    }

    search?.addEventListener("input", filterPrompts);
    categoryContainer?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".category-button");
      if (!button) return;
      activeCategory = button.dataset.category || "all";
      updateButtons();
      filterPrompts();
    });

    typeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeType = button.dataset.type || "all";
        updateButtons();
        filterPrompts();
      });
    });

    resetButton?.addEventListener("click", () => {
      if (search) search.value = "";
      activeCategory = "all";
      activeType = "all";
      updateButtons();
      filterPrompts();
    });

    loadPrompts();
  </script>
</MainLayout>

<style is:global>
  .prompts-page {
    min-height: 100vh;
    padding-bottom: 100px;
    color: #f3f2f7;
  }

  .prompts-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 78px 24px 65px;
    border-bottom: 1px solid rgba(255,255,255,.07);
    background:
      linear-gradient(180deg,rgba(10,11,15,.3),rgba(8,9,12,.94)),
      radial-gradient(ellipse at 48% 0%,rgba(50,111,178,.17),transparent 48%);
    text-align: center;
  }

  .prompts-hero::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background:
      linear-gradient(90deg,transparent 0 12%,rgba(255,255,255,.025) 12.2%,transparent 12.8% 28%,rgba(78,150,230,.09) 28.2%,transparent 29% 71%,rgba(255,255,255,.025) 71.2%,transparent 72% 87%,rgba(251,113,133,.10) 87.2%,transparent 88%),
      radial-gradient(rgba(255,255,255,.16) .65px,transparent .8px);
    background-size: auto,19px 19px;
    opacity: .65;
  }

  .hero-light {
    position: absolute;
    z-index: -1;
    width: 310px;
    height: 310px;
    border-radius: 50%;
    filter: blur(105px);
    pointer-events: none;
  }

  .hero-light-blue {
    top: -160px;
    left: 22%;
    background: rgba(59,130,246,.17);
  }

  .hero-light-rose {
    top: -120px;
    right: 13%;
    background: rgba(244,63,94,.12);
  }

  .hero-inner {
    position: relative;
    width: min(100%,780px);
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 13px;
    border: 1px solid rgba(96,165,250,.23);
    border-radius: 999px;
    background: rgba(59,130,246,.07);
    color: #a5ccff;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .12em;
  }

  .eyebrow i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #60a5fa;
    box-shadow: 0 0 10px #60a5fa;
  }

  .prompts-hero h1 {
    margin: 24px 0 0;
    color: #f4f2f7;
    font-family: "Space Grotesk",sans-serif;
    font-size: clamp(42px,6vw,66px);
    font-weight: 600;
    letter-spacing: -.065em;
    line-height: 1.08;
  }

  .prompts-hero h1 span {
    background: linear-gradient(100deg,#8fc5ff,#a9a0ff 58%,#ff9eaa);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero-subtitle {
    margin: 17px 0 0;
    color: #999aa7;
    font-size: 14px;
  }

  .search-field {
    display: flex;
    width: min(100%,660px);
    min-height: 61px;
    align-items: center;
    gap: 13px;
    margin: 34px auto 0;
    padding: 8px 16px;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 15px;
    background: rgba(24,25,32,.82);
    box-shadow: 0 16px 48px rgba(0,0,0,.25),inset 0 1px 0 rgba(255,255,255,.045);
    backdrop-filter: blur(20px);
    transition: border-color .2s ease,box-shadow .2s ease;
  }

  .search-field:focus-within {
    border-color: rgba(96,165,250,.5);
    box-shadow: 0 0 0 3px rgba(59,130,246,.08),0 16px 48px rgba(0,0,0,.3);
  }

  .search-field svg {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    fill: none;
    stroke: #80b8f5;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .search-field input {
    width: 100%;
    min-width: 0;
    height: 42px;
    border: 0;
    outline: none;
    background: transparent;
    color: #f4f3f7;
    font-size: 13px;
    box-shadow: none;
  }

  .search-field input:focus {
    border: 0;
    outline: none;
    box-shadow: none;
  }

  .search-field input::placeholder {
    color: #777985;
  }

  .search-field kbd {
    flex-shrink: 0;
    color: #727481;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .08em;
  }

  .hero-rule {
    position: absolute;
    right: 5%;
    bottom: 0;
    left: 5%;
    height: 1px;
    background: linear-gradient(90deg,transparent,rgba(96,165,250,.28),rgba(251,113,133,.2),transparent);
  }

  .prompt-collection {
    width: min(100% - 48px,1250px);
    margin: 0 auto;
    padding-top: 44px;
  }

  .toolbar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 42px;
  }

  .filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .type-button,
  .category-button {
    min-height: 42px;
    padding: 0 17px;
    border: 1px solid rgba(255,255,255,.11);
    border-radius: 11px;
    background: rgba(255,255,255,.025);
    color: #a7a7b4;
    font-size: 12px;
    cursor: pointer;
    transition: .2s ease;
  }

  .type-button:hover,
  .category-button:hover {
    border-color: rgba(255,255,255,.25);
    color: #f4f4f7;
    transform: translateY(-1px);
  }

  .type-button.active,
  .category-button.active {
    border-color: rgba(251,146,60,.48);
    background: linear-gradient(110deg,rgba(249,115,22,.20),rgba(251,191,36,.08));
    color: #fed7aa;
    box-shadow: 0 5px 20px rgba(249,115,22,.07);
  }

  .type-button span {
    margin-left: 7px;
    color: #fdba74;
    font-family: "JetBrains Mono",monospace;
    font-size: 10px;
  }

  .type-button.type-image.active {
    border-color: rgba(52,211,153,.45);
    background: rgba(16,185,129,.12);
    color: #6ee7b7;
  }

  .type-button.type-video.active {
    border-color: rgba(167,139,250,.48);
    background: rgba(139,92,246,.14);
    color: #c4b5fd;
  }

  .type-button.type-other.active {
    border-color: rgba(56,189,248,.45);
    background: rgba(14,165,233,.12);
    color: #7dd3fc;
  }

  .category-filter-block {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .filter-label {
    color: #8b8b98;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .16em;
  }

  .category-filters {
    gap: 9px;
  }

  .category-button.active {
    border-color: rgba(96,165,250,.42);
    background: rgba(59,130,246,.12);
    color: #bfdbfe;
  }

  .results-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .results-kicker {
    color: #fbbf24;
    font-family: "JetBrains Mono",monospace;
    font-size: 9px;
    letter-spacing: .14em;
  }

  .results-heading h2 {
    margin: 7px 0 0;
    color: #f0eef4;
    font-family: "Space Grotesk",sans-serif;
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -.045em;
  }

  .results-heading h2 span {
    color: #f59e0b;
  }

  .results-heading > p {
    margin: 0 0 3px;
    color: #858692;
    font-size: 11px;
  }

  .results-heading > p strong {
    color: #a9cfff;
    font-family: "JetBrains Mono",monospace;
    font-weight: 500;
  }

  .prompt-grid {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    align-items: stretch;
    gap: 18px;
  }

  .prompt-card {
    --accent: #fbbf24;
